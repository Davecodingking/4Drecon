+"""RoHM 输入第 1 步(MHR 的 pixi 环境, cwd = 转换工具目录): 原版流水线最终结果里这个人的 MHR 网格 -> SMPL-X 1.0 参数。
+
+网格用 OmniEgoCap/ours/export_mhr.py 已经导出的那份(r1_fp3_fair_base 的 10_people_params, y 朝上的 Wy 系, cm), 两个方法输入同源。
+单一体型(整段一个 betas), 按时间顺序用上一帧初始化。输出: ours/inputs/p<pid>_smplx_Wy.npz(SMPL-X 参数, Wy 系)。
+用法:
+  cd ~/sam3d/redir/third_party/MHR/tools/mhr_smpl_conversion && \
+  ~/sam3d/redir/third_party/MHR/.pixi/envs/default/bin/python ~/sam3d/RoHM/ours/fit_smplx.py --pid 4
+"""
+import argparse, os, sys
+import numpy as np
+import torch
+import smplx
+from mhr.mhr import MHR
+sys.path.insert(0, os.getcwd())
+from conversion import Conversion
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SMPLX_NPZ = '/home/ubuntu/sam3d/DuoMo/data/body_models/smplx/SMPLX_NEUTRAL.npz'   # version.txt: SMPL-X 1.0, 和 RoHM 用的一致
+MHR_IN = '/home/ubuntu/sam3d/OmniEgoCap/ours/inputs'
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--pid', type=int, required=True)
+    a = ap.parse_args()
+    d = np.load(f'{MHR_IN}/p{a.pid}_mhr_world.npz')
+    mhr = MHR.from_files(lod=1, device=torch.device('cpu'))
+    model = smplx.SMPLX(model_path=SMPLX_NPZ, gender='neutral', use_pca=False, flat_hand_mean=True)
+    conv = Conversion(mhr_model=mhr, smpl_model=model, method='pytorch')
+    out = conv.convert_mhr2smpl(mhr_vertices=torch.tensor(d['V_Wy_cm']), single_identity=True, is_tracking=True,
+                                return_smpl_parameters=True, return_fitting_errors=True)
+    P = {k: (v.detach().cpu().numpy() if torch.is_tensor(v) else np.asarray(v)) for k, v in out.result_parameters.items()}
+    err = np.asarray(out.result_errors)
+    os.makedirs(f'{HERE}/inputs', exist_ok=True)
+    np.savez(f'{HERE}/inputs/p{a.pid}_smplx_Wy.npz', errors=err, vf=d['vf'], fps=d['fps'],
+             R_W_da3=d['R_W_da3'], t_W_da3=d['t_W_da3'], w2c_da3=d['w2c_da3'], K=d['K'], input_hw=d['input_hw'], **P)
+    print('MHR -> SMPL-X 拟合误差(工具口径): 中位', np.median(err), '最大', err.max(), '; 参数', {k: v.shape for k, v in P.items()})
+
+
+if __name__ == '__main__':
+    main()

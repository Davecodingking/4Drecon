index 0000000..2fcceb7
--- /dev/null
+++ b/ours/rohm_ours.py
@@ -0,0 +1,209 @@
+"""RoHM 跑我们的 office 数据(rohm 环境, cwd = RoHM 仓库根目录)。三步:
+
+  prep: ours/inputs/p<pid>_smplx_Wy.npz(fit_smplx.py 的结果, 原版流水线最终结果拟合成的 SMPL-X, y 朝上 Wy 系)
+        -> z 朝上的世界 W(地面 z=0, 和 OmniEgoCap 那次同一个 W) -> 按时间插值成 30 fps(位置线性, 旋转球面插值)
+        -> 22 个关节位置 + 25 个关节"看得见"(关键帧上投影在画面内且在相机前; 两个关键帧之间取较近那一帧)
+        -> ours/inputs/p<pid>_rohm_input.npz
+  run:  ours/run_rohm.py(由官方 test_prox_egobody.py 改的, 见那个文件开头)用下面的 DataloaderOurs 读这个文件
+  post: 每个片段的输出(规整坐标系) -> 世界 W -> 片段重叠处线性过渡拼成整段 -> ours/outputs/p<pid>_rohm_W.npz
+
+和官方 PROX 流程的差别(PROX 是固定相机, 我们是移动相机):
+  - 不读 OpenPose 2D 关键点; 关节可见性只用投影判断, 置信度全给 1(所以 mask = 我们的投影可见性)
+  - 生成时用 'amass' 引导(只有防脚滑), 不用 'prox' 引导(它要固定相机做 2D 投影)
+  - 片段尾巴: 官方切片段时凑不满一段的尾巴直接丢掉; 这里补一段和结尾对齐的片段, 保证整段都有结果
+"""
+import argparse, os, sys
+import numpy as np
+from scipy.spatial.transform import Rotation as Rot, Slerp
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(HERE)
+sys.path.insert(0, ROOT)
+BODY_MODEL = f'{ROOT}/data/body_models/smplx_model'
+WY2W = np.array([[1, 0, 0], [0, 0, -1], [0, 1, 0.]])   # (x, y, z)_Wy -> (x, -z, y)_W, 见 OmniEgoCap/ours/export_mhr.py
+FPS = 30
+
+
+def smplx_model(device='cpu'):
+    import smplx
+    return smplx.create(model_path=BODY_MODEL, model_type='smplx', gender='neutral', flat_hand_mean=True, use_pca=False).to(device)
+
+
+def body_joints(model, P, device='cpu'):
+    """SMPL-X 参数(global_orient, transl, betas, body_pose) -> 前 22 个关节 (T, 22, 3)。手、脸都用 0。"""
+    import torch
+    T = len(P['transl'])
+    with torch.no_grad():
+        out = model(**{k: torch.tensor(np.asarray(P[k]), dtype=torch.float32, device=device) for k in ('global_orient', 'transl', 'betas', 'body_pose')},
+                    jaw_pose=torch.zeros(T, 3, device=device), leye_pose=torch.zeros(T, 3, device=device), reye_pose=torch.zeros(T, 3, device=device),
+                    left_hand_pose=torch.zeros(T, 45, device=device), right_hand_pose=torch.zeros(T, 45, device=device),
+                    expression=torch.zeros(T, 10, device=device))
+    return out.joints[:, :25].cpu().numpy(), out.vertices.cpu().numpy()
+
+
+def rest_pelvis(model, betas):
+    P = {'global_orient': np.zeros((1, 3)), 'transl': np.zeros((1, 3)), 'betas': betas[:1], 'body_pose': np.zeros((1, 63))}
+    return body_joints(model, P)[0][0, 0]
+
+
+def rigid(P, R, t, J0):
+    """把 SMPL-X 的全局朝向/平移换到 x' = R x + t 的坐标系(全局旋转绕骨盆 J0 转)。"""
+    out = dict(P)
+    out['global_orient'] = (Rot.from_matrix(R) * Rot.from_rotvec(P['global_orient'])).as_rotvec()
+    out['transl'] = (P['transl'] + J0) @ R.T + t - J0
+    return out
+
+
+def prep(pid):
+    d = np.load(f'{HERE}/inputs/p{pid}_smplx_Wy.npz')
+    betas = d['betas'].reshape(-1, d['betas'].shape[-1])[:, :10]
+    betas = np.repeat(betas[:1], len(d['transl']), 0)                     # 单一体型
+    P = {'global_orient': d['global_orient'].reshape(-1, 3), 'transl': d['transl'].reshape(-1, 3),
+         'betas': betas, 'body_pose': d['body_pose'].reshape(-1, 63)}
+    model = smplx_model()
+    J0 = rest_pelvis(model, betas)
+    PW = rigid(P, WY2W, np.zeros(3), J0)
+
+    tk = d['vf'] / float(d['fps'])
+    t30 = tk[0] + np.arange(int(np.floor((tk[-1] - tk[0]) * FPS)) + 1) / FPS
+    P30 = {'transl': np.stack([np.interp(t30, tk, PW['transl'][:, i]) for i in range(3)], 1),
+           'global_orient': Slerp(tk, Rot.from_rotvec(PW['global_orient']))(t30).as_rotvec(),
+           'betas': np.repeat(betas[:1], len(t30), 0),
+           'body_pose': np.stack([Slerp(tk, Rot.from_rotvec(PW['body_pose'][:, 3 * j:3 * j + 3]))(t30).as_rotvec() for j in range(21)], 1).reshape(-1, 63)}
+    J30, _ = body_joints(model, P30)
+    Jk, _ = body_joints(model, PW)
+
+    # 关节看得见: 关键帧上投影在画面内(留 2% 边)且在相机前
+    R, t = d['R_W_da3'], d['t_W_da3']
+    H, Wd = d['input_hw']
+    vis_k = np.zeros((len(tk), 25), bool)
+    for i in range(len(tk)):
+        p = (Jk[i] - t) @ R                                                # W -> DA3: R^T (p - t)
+        c = p @ d['w2c_da3'][i, :3, :3].T + d['w2c_da3'][i, :3, 3]
+        uv = c[:, :2] / np.maximum(c[:, 2:], 1e-6) @ np.diag([d['K'][i][0, 0], d['K'][i][1, 1]]) + d['K'][i][:2, 2]
+        vis_k[i] = (c[:, 2] > 0.1) & (uv[:, 0] > 0.02 * Wd) & (uv[:, 0] < 0.98 * Wd) & (uv[:, 1] > 0.02 * H) & (uv[:, 1] < 0.98 * H)
+    nearest = np.abs(t30[:, None] - tk[None]).argmin(1)
+    vis = vis_k[nearest]
+    names = ['pelvis', 'l_hip', 'r_hip', 'spine1', 'l_knee', 'r_knee', 'spine2', 'l_ankle', 'r_ankle', 'spine3', 'l_foot', 'r_foot',
+             'neck', 'l_collar', 'r_collar', 'head', 'l_shoulder', 'r_shoulder', 'l_elbow', 'r_elbow', 'l_wrist', 'r_wrist']
+    print('各关节看得见的比例:', ', '.join(f'{n} {vis[:, j].mean():.2f}' for j, n in enumerate(names)))
+    print('全身最低关节离地中位 %.3f m; 头关节离地中位 %.2f m' % (np.median(J30[:, :22, 2].min(1)), np.median(J30[:, 15, 2])))
+    out = f'{HERE}/inputs/p{pid}_rohm_input.npz'
+    np.savez(out, smplx_world=np.concatenate([P30['global_orient'], P30['transl'], P30['betas'], P30['body_pose']], 1).astype(np.float32),
+             joints_world=J30.astype(np.float32), mask_joint=vis.astype(np.float32), time_s=t30, K=d['K'][0])
+    print(f'{len(t30)} 帧 @30fps -> {out}')
+
+
+try:
+    from data_loaders.dataloader_video import DataloaderVideo
+except Exception:                                                           # prep/post 不需要它
+    DataloaderVideo = object
+
+
+class DataloaderOurs(DataloaderVideo):
+    """沿用官方 DataloaderVideo 的全部处理(规整坐标、切片段、可见性遮罩), 只把 PROX 的读数据换成读我们的 npz(init_root 指向它)。"""
+
+    def read_data_prox(self):
+        d = np.load(self.init_root)
+        self.scene_floor_height = 1e-6        # W 的地面就在 z=0; 给 0 会被官方代码当成"没给", 改用关节最低点当地面
+        K = d['K']
+        self.color_cam = {'f': [float(K[0, 0]), float(K[1, 1])], 'c': [float(K[0, 2]), float(K[1, 2])],
+                          'camera_mtx': K.tolist(), 'k': [0.0] * 5}
+        joints = d['joints_world'][:, :self.joints_num]
+        smplx_world = d['smplx_world']
+        kp = np.zeros((len(joints), self.joints_num, 3), np.float32)
+        kp[:, :, 2] = 1.0                                                   # 置信度全 1: 可见性只由 mask_joint 决定
+        mask = d['mask_joint']
+        names = np.array([f'{i:05d}' for i in range(len(joints))])
+        n, L, step = len(joints), self.clip_len, self.clip_len - self.clip_overlap_len
+        starts = list(range(0, n - L + 1, step))
+        if starts[-1] != n - L:
+            starts.append(n - L)                                            # 补一段和结尾对齐的片段
+        self.clip_starts = starts
+        self.frame_name_list, self.joints_clip_world_list, self.smplx_clip_world_list = [], [], []
+        self.keypoints_2d_list, self.joint_mask_list = [], []
+        for s in starts:
+            self.frame_name_list.append(list(names[s:s + L]))
+            self.joints_clip_world_list.append(joints[s:s + L])
+            self.smplx_clip_world_list.append(smplx_world[s:s + L])
+            self.keypoints_2d_list.append(kp[s:s + L])
+            self.joint_mask_list.append(mask[s:s + L][:, :self.joints_num])
+        self.n_samples = len(starts)
+        print(f'[INFO] ours: {n} 帧, 切成 {self.n_samples} 段, 起点 {starts}')
+
+
+def post(pid, result_pkl, clip_len, overlap, tag=''):
+    import pickle, torch
+    from data_loaders.motion_representation import REPR_LIST, REPR_DIM_DICT
+    from data_loaders.common.quaternion import rot6d_to_rotmat
+    r = pickle.load(open(result_pkl, 'rb'))
+    rep = r['motion_repr_rec_list']                                         # [n_clip, 143, dim] 规整坐标系
+    trans = r['trans_scene2cano_list']                                      # [n_clip, 4, 4] 世界 -> 规整
+    d = np.load(f'{HERE}/inputs/p{pid}_rohm_input.npz')
+    n = len(d['time_s'])
+    step = clip_len - overlap
+    starts = list(range(0, n - clip_len + 1, step))
+    if starts[-1] != n - clip_len:
+        starts.append(n - clip_len)
+    assert len(starts) == len(rep), (len(starts), len(rep))
+    model = smplx_model()
+    acc = {k: np.zeros((n, dim)) for k, dim in [('transl', 3), ('global_orient_q', 4), ('body_pose_q', 21 * 4), ('betas', 10), ('contact', 4)]}
+    wsum = np.zeros(n)
+    for c, s in enumerate(starts):
+        cur, dims = 0, {}
+        for name in REPR_LIST:
+            dims[name] = rep[c][:, cur:cur + REPR_DIM_DICT[name]]
+            cur += REPR_DIM_DICT[name]
+        T = len(dims['smplx_trans'])
+        go = rot6d_to_rotmat(torch.tensor(dims['smplx_rot_6d'], dtype=torch.float32)).numpy().reshape(T, 3, 3)
+        bp = rot6d_to_rotmat(torch.tensor(dims['smplx_body_pose_6d'].reshape(-1, 6), dtype=torch.float32)).numpy().reshape(T, 21, 3, 3)
+        P = {'global_orient': Rot.from_matrix(go).as_rotvec(), 'transl': dims['smplx_trans'], 'betas': dims['smplx_betas'],
+             'body_pose': Rot.from_matrix(bp.reshape(-1, 3, 3)).as_rotvec().reshape(T, 63)}
+        inv = np.linalg.inv(trans[c])                                       # 规整 -> 世界
+        PW = rigid(P, inv[:3, :3], inv[:3, 3], rest_pelvis(model, P['betas']))
+        w = np.ones(T)                                                      # 重叠处线性过渡
+        if c > 0:
+            ov = starts[c - 1] + T - s
+            if ov > 0:
+                w[:ov] = np.linspace(0, 1, ov + 2)[1:-1]
+        if c < len(starts) - 1:
+            ov = s + T - starts[c + 1]
+            if ov > 0:
+                w[T - ov:] = np.minimum(w[T - ov:], np.linspace(1, 0, ov + 2)[1:-1])
+        q = Rot.from_rotvec(PW['global_orient']).as_quat()
+        qb = Rot.from_rotvec(PW['body_pose'].reshape(-1, 3)).as_quat().reshape(T, 21, 4)
+        idx = np.arange(s, s + T)
+        for arr, val in [('transl', PW['transl']), ('betas', PW['betas']), ('contact', dims['foot_contact'])]:
+            acc[arr][idx] += w[:, None] * val
+        prev_q = acc['global_orient_q'][idx]                               # 四元数同号再加权
+        q *= np.sign(np.sum(prev_q * q, 1, keepdims=True) + 1e-9)
+        acc['global_orient_q'][idx] += w[:, None] * q
+        prev_b = acc['body_pose_q'][idx].reshape(T, 21, 4)
+        qb *= np.sign(np.sum(prev_b * qb, 2, keepdims=True) + 1e-9)
+        acc['body_pose_q'][idx] += (w[:, None, None] * qb).reshape(T, -1)
+        wsum[idx] += w
+    covered = wsum > 0
+    print(f'有结果的帧 {covered.sum()}/{n}' + ('' if covered.all() else f'; 缺 {np.nonzero(~covered)[0][[0, -1]]}'))
+    for k in acc:
+        acc[k][covered] /= wsum[covered, None]
+    go = Rot.from_quat(acc['global_orient_q'][covered]).as_rotvec()
+    bp = Rot.from_quat(acc['body_pose_q'][covered].reshape(-1, 4)).as_rotvec().reshape(-1, 63)
+    PW = {'global_orient': go, 'transl': acc['transl'][covered], 'betas': acc['betas'][covered], 'body_pose': bp}
+    J, V = body_joints(model, PW)
+    os.makedirs(f'{HERE}/outputs', exist_ok=True)
+    out = f'{HERE}/outputs/p{pid}_rohm{tag}_W.npz'
+    np.savez(out, time_s=d['time_s'][covered], joints=J[:, :22].astype(np.float32), vertices=V.astype(np.float32),
+             contact=acc['contact'][covered].astype(np.float32), faces=model.faces.astype(np.int32), **{k: v.astype(np.float32) for k, v in PW.items()})
+    print('->', out)
+
+
+if __name__ == '__main__':
+    ap = argparse.ArgumentParser()
+    ap.add_argument('step', choices=['prep', 'post'])
+    ap.add_argument('--pid', type=int, required=True)
+    ap.add_argument('--result', default='')
+    ap.add_argument('--clip_len', type=int, default=145)
+    ap.add_argument('--overlap', type=int, default=30)
+    ap.add_argument('--tag', default='', help='输出文件名后缀, 如 _prox -> p<pid>_rohm_prox_W.npz')
+    a = ap.parse_args()
+    prep(a.pid) if a.step == 'prep' else post(a.pid, a.result, a.clip_len, a.overlap, a.tag)

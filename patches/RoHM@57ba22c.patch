+"""原始输出(没进流水线, 30 fps)看腿的对比视频(sam3d 环境): 固定侧面相机, 只画地面(0.5 m 格子) + 这个人, 三栏并排。
+三栏都在同一个 z 朝上、地面 z=0 的世界 W 里(见 OmniEgoCap/ours/export_mhr.py):
+  原版输入(流水线最终结果 -> SMPL-X, 插值到 30fps) | OmniEgoCap 原始输出 | RoHM 原始输出
+相机全程不动, 人走过去时脚有没有在地上滑能直接看出来。
+用法: python ours/legs_video_raw.py --pid 4 [--settings]
+"""
+import argparse, os, subprocess, tempfile, shutil
+os.environ['PYOPENGL_PLATFORM'] = 'egl'
+import numpy as np, trimesh, pyrender, cv2, imageio_ffmpeg
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--pid', type=int, required=True)
+    ap.add_argument('--settings', action='store_true', help='三栏换成: 原版输入 | RoHM A 套 | RoHM B 套(官方真实视频设置)')
+    a = ap.parse_args()
+    srcs = [('original (input)', f'{HERE}/outputs/p{a.pid}_input_W_verts.npz'),
+            ('OmniEgoCap raw', f'/home/ubuntu/sam3d/OmniEgoCap/ours/outputs/p{a.pid}_omni_W_verts.npz'),
+            ('RoHM raw', f'{HERE}/outputs/p{a.pid}_rohm_W.npz')]
+    if a.settings:
+        srcs = [srcs[0], ('RoHM A (amass_occ_leg)', srcs[2][1]), ('RoHM B (prox real-video)', f'{HERE}/outputs/p{a.pid}_rohm_prox_W.npz')]
+    data = [np.load(p) for _, p in srcs]
+    n = min(len(d['vertices']) for d in data)
+    c = data[0]['vertices'][:n].mean(1); c[:, 2] = 0
+    mid = c.mean(0)
+    P = c - mid
+    walk = np.linalg.svd(P, full_matrices=False)[2][0]; walk[2] = 0; walk /= np.linalg.norm(walk)
+    UP = np.array([0, 0, 1.0])
+    side = np.cross(UP, walk)
+    eye = mid + 5.5 * side + 1.0 * UP
+    z = (mid + 0.8 * UP) - eye; z /= np.linalg.norm(z)
+    x = np.cross(-UP, z); x /= np.linalg.norm(x); y = np.cross(z, x)
+    c2w = np.eye(4); c2w[:3, 0], c2w[:3, 1], c2w[:3, 2], c2w[:3, 3] = x, y, z, eye
+    pose = c2w @ np.diag([1, -1, -1, 1])
+    W, H = 640, 400
+    r = pyrender.OffscreenRenderer(W, H)
+    fq = np.array([mid + u * walk * 4 + v * side * 3 for u, v in [(-1, -1), (1, -1), (1, 1), (-1, 1)]])
+    floor = trimesh.Trimesh(fq, [[0, 1, 2], [0, 2, 3], [0, 2, 1], [0, 3, 2]], process=False)
+    lines = []
+    for k in np.arange(-4, 4.01, 0.5):
+        for p0, p1 in [(mid + k * walk - 3 * side, mid + k * walk + 3 * side), (mid - 4 * walk + 0.75 * k * side, mid + 4 * walk + 0.75 * k * side)]:
+            lines.append(trimesh.creation.cylinder(radius=0.006, segment=[p0 + 0.002 * UP, p1 + 0.002 * UP]))
+    grid = trimesh.util.concatenate(lines); grid.visual.vertex_colors = [90, 90, 90, 255]
+    tmp = tempfile.mkdtemp()
+    for i in range(n):
+        cols = []
+        for (name, _), d in zip(srcs, data):
+            s = pyrender.Scene(bg_color=[1, 1, 1, 1], ambient_light=[.45] * 3)
+            s.add(pyrender.Mesh.from_trimesh(floor, smooth=False))
+            s.add(pyrender.Mesh.from_trimesh(grid, smooth=False))
+            m = trimesh.Trimesh(d['vertices'][i], d['faces'], process=False)
+            m.visual.vertex_colors = [230, 120, 200, 255]
+            s.add(pyrender.Mesh.from_trimesh(m, smooth=True))
+            s.add(pyrender.IntrinsicsCamera(fx=1.1 * W, fy=1.1 * W, cx=W / 2, cy=H / 2), pose=pose)
+            s.add(pyrender.DirectionalLight(intensity=3.5), pose=pose)
+            img = r.render(s)[0].copy()
+            cv2.putText(img, f'{name}  {i / 30:.1f}s', (8, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2, cv2.LINE_AA)
+            cols.append(img)
+        cv2.imwrite(f'{tmp}/{i:05d}.jpg', cv2.cvtColor(np.hstack(cols), cv2.COLOR_RGB2BGR), [cv2.IMWRITE_JPEG_QUALITY, 92])
+    out = f'{HERE}/outputs/compare_p{a.pid}_' + ('rohm_settings' if a.settings else 'raw_legs') + '_30fps.mp4'
+    subprocess.run([imageio_ffmpeg.get_ffmpeg_exe(), '-y', '-loglevel', 'error', '-framerate', '30', '-i', f'{tmp}/%05d.jpg',
+                    '-c:v', 'libx264', '-pix_fmt', 'yuv420p', '-crf', '22', out], check=True)
+    shutil.rmtree(tmp)
+    print(n, '帧 @30fps ->', out)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ours/rohm_ours.py b/ours/rohm_ours.py

+#!/usr/bin/env bash
+# 领一张卡(和 sam3d 流水线同一套锁)跑 RoHM: run.sh <pid> [多的参数传给 run_rohm.py]; 输入先用 rohm_ours.py prep 准备
+set -eo pipefail
+PID=$1
+export CUDA_DEVICE_ORDER=PCI_BUS_ID
+CARD=""
+until [ -n "$CARD" ]; do
+  for row in $(nvidia-smi --query-gpu=index,memory.used,memory.total --format=csv,noheader,nounits | tr -d ' ' | sort -t, -k2 -n); do
+    IFS=, read -r idx used total <<< "$row"
+    exec 9>>"/tmp/outdoor_pipeline_gpu${idx}.lock"
+    if flock -n 9 && [ $(( total - used )) -ge 16000 ]; then CARD=$idx; break; fi
+    exec 9>&-
+  done
+  [ -n "$CARD" ] || sleep 20
+done
+export CUDA_VISIBLE_DEVICES=$CARD OMP_NUM_THREADS=8 MKL_NUM_THREADS=8
+source /home/ubuntu/miniforge3/etc/profile.d/conda.sh
+conda activate rohm
+echo "card $CARD"
+cd /home/ubuntu/sam3d/RoHM
+python ours/run_rohm.py --config ours/run_cfg.yaml --init_root ours/inputs/p${PID}_rohm_input.npz --recording_name office_p${PID} --device 0 "${@:2}"

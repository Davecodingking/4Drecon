@@ -0,0 +1,62 @@
+"""原始输出(30 fps, 没进流水线)的指标(rohm 环境, cwd = RoHM 仓库根目录), 和 README 里方案 A 的数同一个算法:
+  贴地点滑动: 地面取这个方法自己全身最低点的 5% 分位; 两帧都离地 < 1.5 cm 的同一批顶点, 每帧对取水平速度中位, 再对所有帧对取中位
+  脚踝离地变化: 踝关节高度 95% 分位 - 5% 分位
+  两脚悬空: 全身最低点离地(地面 z=0) > 8 cm 的帧比例; 另外按 RoHM 的 5 段分别给
+用法: python ours/eval_raw.py --pid 4 --runs _ _prox   (p<pid>_rohm<tag>_W.npz)
+"""
+import argparse, sys, os
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from rohm_ours import smplx_model, body_joints
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+STARTS, L = [0, 115, 230, 345, 395], 145
+
+
+def vslide(V, t, thr=0.015):
+    h = V[..., 2]; h = h - np.percentile(h.min(1), 5); sp = []; n = 0
+    for i in range(len(V) - 1):
+        ids = np.nonzero((h[i] < thr) & (h[i + 1] < thr))[0]
+        if len(ids) < 5:
+            continue
+        n += 1; d = V[i + 1][ids] - V[i][ids]; d[:, 2] = 0
+        sp.append(np.median(np.linalg.norm(d, axis=1)) / (t[i + 1] - t[i]))
+    return np.median(sp) * 100, n / (len(V) - 1)
+
+
+def knee(J, a, b, c):
+    u, w = J[:, a] - J[:, b], J[:, c] - J[:, b]
+    return np.degrees(np.arccos((u * w).sum(1) / np.linalg.norm(u, axis=1) / np.linalg.norm(w, axis=1)))
+
+
+def report(name, V, J, t, Jin=None):
+    s, cov = vslide(V, t)
+    lift = [np.percentile(J[:, j, 2], 95) - np.percentile(J[:, j, 2], 5) for j in (7, 8)]
+    low = V[..., 2].min(1)
+    seg = ' '.join('%.0f%%' % (100 * np.mean(low[s0:s0 + L] > 0.08)) for s0 in STARTS)
+    print('%-22s 滑动 %5.1f cm/s(贴地帧对 %3.0f%%) | 踝离地变化 %2.0f/%2.0f cm | 两脚悬空>8cm %4.1f%% (5段: %s) | 膝角中位 L%3.0f R%3.0f 最小 %3.0f'
+          % (name, s, cov * 100, lift[0] * 100, lift[1] * 100, 100 * np.mean(low > 0.08), seg,
+             np.median(knee(J, 1, 4, 7)), np.median(knee(J, 2, 5, 8)), min(knee(J, 1, 4, 7).min(), knee(J, 2, 5, 8).min())))
+    if Jin is not None:
+        n = len(J); dev = np.linalg.norm(J[:, 0, :2] - Jin[:n, 0, :2], axis=1)
+        print('%-22s 骨盆水平位置和输入差 中位 %.1f cm, 最大 %.1f cm' % ('', np.median(dev) * 100, dev.max() * 100))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--pid', type=int, required=True)
+    ap.add_argument('--runs', nargs='+', default=['_'], help="输出文件后缀, '_' 表示没后缀(方案 A 那次)")
+    a = ap.parse_args()
+    m = smplx_model()
+    inp = np.load(f'{HERE}/inputs/p{a.pid}_rohm_input.npz'); s = inp['smplx_world']
+    Ji, Vi = body_joints(m, {'global_orient': s[:, 0:3], 'transl': s[:, 3:6], 'betas': s[:, 6:16], 'body_pose': s[:, 16:79]})
+    Ji = Ji[:, :22]
+    report('输入(原版插值30fps)', Vi, Ji, inp['time_s'])
+    for tag in a.runs:
+        tag = '' if tag == '_' else tag
+        o = np.load(f'{HERE}/outputs/p{a.pid}_rohm{tag}_W.npz')
+        report(f'RoHM{tag or "(A 套)"}', o['vertices'], o['joints'], o['time_s'], Ji)
+
+
+if __name__ == '__main__':
+    main()

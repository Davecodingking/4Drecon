+"""FP 判前后的离线实验(2026-10-23): 不改流水线, 拿一轮已经摆好的场景, 每个物体在
+"现在摆的朝向"和"绕竖直轴转 180°"之间让 FP 选。只读那一轮的文件, 结果写到 --out。
+
+每个物体:
+  1. 从 07_scene_phy.glb 取出摆好的网格, 用 world_frame.inverse_T 转回 DA3 世界系(和渲染回图同一个变换)
+  2. 用生成时那一帧(06_solo.log 里"第 N 帧")的相机、DA3 深度、SAM3 抠图
+  3. 先核对: 按现在的位姿渲染出轮廓, 和抠图算重合度(IoU)。对不上说明变换错了, 后面的打分没意义
+  4. 两个候选: 现在的朝向 / 绕"天"转 180°。打分两种都记: 只打分(不修), 和修正 2 轮之后再打分
+  5. 存一张对比图: 照片 | 按现在朝向渲染 | 按转 180° 渲染
+用法: python ours/flip_eval.py --r1 <轮次目录> --out <输出目录> [--only 词_号,...]"""
+import sys, os, re, json, argparse, logging, warnings
+warnings.filterwarnings("ignore")
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.expanduser("~/sam3d/data/outdoor/scripts"))
+from estimater import *
+from pycocotools import mask as mask_util
+from world_frame import load_up, inverse_T
+logging.getLogger().setLevel(logging.WARNING)
+
+ap = argparse.ArgumentParser(); ap.add_argument("--r1", required=True); ap.add_argument("--out", required=True)
+ap.add_argument("--scene", default="07_scene_phy.glb"); ap.add_argument("--only", default="")
+ap.add_argument("--mode", default="", help="orig = 原版 register() 原样(252 个朝向、自己猜位置); yaw = 我们的位置 + 只绕天转 --nyaw 个")
+ap.add_argument("--nyaw", type=int, default=24)
+ap.add_argument("--grid", type=int, default=0, help="1 = 按 FP 原本用法: 位置用我们对齐的, 朝向从它的 252 个候选里挑, 再看离现在/转180 哪个近")
+ap.add_argument("--diag", type=int, default=0, help="1 = 诊断: 照片/深度分别换成按现在朝向渲染的假图再打分")
+ap.add_argument("--full", type=int, default=0, help="1 = 用原视频帧的分辨率(深度插值放大, 内参按比例放大)")
+a = ap.parse_args(); os.makedirs(a.out, exist_ok=True)
+R1 = a.r1; DA3 = f"{R1}/02_da3"; FR = f"{os.path.dirname(R1)}/frames_{os.path.basename(R1)}"
+
+cams = json.load(open(f"{DA3}/cameras.json"))["cameras"]
+UP, _, _ = load_up(DA3, "fp 判前后"); UP = np.asarray(UP, float); UP /= np.linalg.norm(UP)
+INV = inverse_T(UP)
+# 生成时用的帧: "[office chair#8] 第59帧 占3.30% (68346px) -> off_r12_office_chair_8"
+gen = {}
+for l in open(f"{R1}/logs/06_solo.log"):
+    m = re.match(r"\[(.+)#(\d+)\] 第(\d+)帧", l)
+    if m: gen[(m.group(1), int(m.group(2)))] = int(m.group(3))
+
+def rot_about(axis, deg):
+    a_ = np.deg2rad(deg); k = axis / np.linalg.norm(axis); Kx = np.array([[0, -k[2], k[1]], [k[2], 0, -k[0]], [-k[1], k[0], 0]])
+    T = np.eye(4); T[:3, :3] = np.eye(3) + np.sin(a_) * Kx + (1 - np.cos(a_)) * Kx @ Kx; return T
+
+def mask_of(word, oid, frame, hw):
+    z = np.load(f"{R1}/03_masks/{word.replace(' ', '_')}.npz", allow_pickle=True)
+    meta, counts, (H, W) = z["meta"], z["counts"], z["hw"]
+    i = np.where((meta["oid"] == oid) & (meta["frame"] == frame))[0]
+    if not len(i): return None
+    m = mask_util.decode({"counts": counts[i[0]], "size": [int(H), int(W)]}).astype(np.uint8)
+    return cv2.resize(m, (hw[1], hw[0]), interpolation=cv2.INTER_NEAREST).astype(bool)
+
+def align_ts(P, verts, dep_r, depth, mask, K, iters=30):
+    """朝向不动, 只调位置和大小, 让网格**看得到的那部分**贴上抠图里的深度点。返回新位姿和平均距离(米)。"""
+    from scipy.spatial import cKDTree
+    H, W = depth.shape
+    v_cam = verts @ P[:3, :3].T + P[:3, 3]
+    uv = v_cam @ K.T; u = np.round(uv[:, 0] / uv[:, 2]).astype(int); v = np.round(uv[:, 1] / uv[:, 2]).astype(int)
+    ok = (u >= 0) & (u < W) & (v >= 0) & (v < H)
+    vis = np.zeros(len(verts), bool)
+    vis[ok] = np.abs(dep_r[v[ok], u[ok]] - v_cam[ok, 2]) < 0.03       # 渲染深度 = 自己的深度 -> 没被自己挡住
+    if vis.sum() < 30: return P, float("nan")
+    ys, xs = np.nonzero(mask & (depth > 0.01))
+    if len(ys) < 30: return P, float("nan")
+    sel = np.random.default_rng(0).choice(len(ys), min(3000, len(ys)), replace=False)
+    z = depth[ys[sel], xs[sel]]; Y = np.stack([(xs[sel] - K[0, 2]) * z / K[0, 0], (ys[sel] - K[1, 2]) * z / K[1, 1], z], 1)
+    V0 = verts[vis] @ P[:3, :3].T                                   # 以物体中心为原点、相机朝向的顶点
+    t = P[:3, 3].copy(); s_ = 1.0
+    for _ in range(iters):
+        V = V0 * s_ + t; d, nn = cKDTree(V).query(Y)
+        keep = d < np.percentile(d, 90)                             # 甩掉最远的 10%(抠图边上混进的背景)
+        t = t + (Y[keep] - V[nn[keep]]).mean(0)
+        A = V0[nn[keep]]; s_ = float(np.clip(((Y[keep] - t) * A).sum() / max(1e-9, (A * A).sum()), 0.8, 1.25))
+    V = V0 * s_ + t; d, _ = cKDTree(V).query(Y)
+    Q = P.copy(); Q[:3, :3] = P[:3, :3] * s_; Q[:3, 3] = t
+    return Q, float(np.median(d))
+
+
+def to_rgb8(c): return (c.detach().cpu().numpy() * 255).clip(0, 255).astype(np.uint8)
+
+sc = trimesh.load(f"{R1}/{a.scene}")
+skip = re.compile(r"^(wall|floor|pillar|ground|column)(_\d+)?$")
+only = set(x for x in a.only.split(",") if x)
+glctx = dr.RasterizeCudaContext(); scorer = ScorePredictor(); refiner = PoseRefinePredictor()
+rows = []
+for node in sc.graph.nodes_geometry:
+    if skip.match(node) or (only and node not in only): continue
+    word, oid = node.rsplit("_", 1)[0].replace("_", " "), int(node.rsplit("_", 1)[1])
+    if (word, oid) not in gen: print(f"{node}: 06_solo.log 里找不到生成帧, 跳过"); continue
+    f = gen[(word, oid)]; fn = f"{f:04d}.jpg"; cam = cams.get(fn)
+    if cam is None: print(f"{node}: 第 {f} 帧没有相机, 跳过"); continue
+    K = np.array(cam["intrinsic_3x3"], float); w2c = np.array(cam["extrinsic_w2c_4x4"], float).reshape(4, 4)
+    depth = np.load(f"{DA3}/depth/{f:04d}_depth.npy").astype(np.float32); H, W = depth.shape
+    img = cv2.imread(f"{FR}/{fn}")[..., ::-1]
+    if a.full:   # ★ 原图分辨率: 深度 688x384 下 5 米外的椅子只有 ~80 px 高, FP 裁出来放大到 160 再比, 细节全糊
+        Hf, Wf = img.shape[:2]; K = K.copy(); K[0] *= Wf / W; K[1] *= Hf / H
+        depth = cv2.resize(depth, (Wf, Hf), interpolation=cv2.INTER_LINEAR); H, W = Hf, Wf; rgb = np.ascontiguousarray(img)
+    else:
+        rgb = cv2.resize(img, (W, H), interpolation=cv2.INTER_AREA)
+    mask = mask_of(word, oid, f, (H, W))
+    if mask is None or mask.sum() < 20: print(f"{node}: 第 {f} 帧没有抠图, 跳过"); continue
+
+    T, g = sc.graph[node]; mesh = sc.geometry[g].copy(); mesh.apply_transform(T); mesh.apply_transform(INV)   # -> DA3 世界系
+    if isinstance(mesh.visual, trimesh.visual.texture.TextureVisuals) and not hasattr(mesh.visual.material, "image"):
+        mesh.visual.material = mesh.visual.material.to_simple()     # ★ FP 只认普通贴图(见 NOTES.md 坑 6)
+    c = mesh.bounds.mean(0); mesh.vertices -= c                       # 物体系: 原点在盒子中心, 轴和世界系一致
+    Tc = np.eye(4); Tc[:3, 3] = c
+    cur = w2c @ Tc; flip = cur @ rot_about(UP, 180)                   # 绕"天"转 180°
+    Pc0 = cur.copy()                                                  # 原流程摆的, 出对比图用
+    est = FoundationPose(model_pts=mesh.vertices, model_normals=mesh.vertex_normals, mesh=mesh, scorer=scorer, refiner=refiner,
+                         glctx=glctx, debug=0, debug_dir=a.out)
+    assert np.allclose(est.get_tf_to_centered_mesh().cpu().numpy(), np.eye(4), atol=1e-4)
+    P = torch.as_tensor(np.stack([cur, flip]), dtype=torch.float, device="cuda")
+    col, dep, _ = nvdiffrast_render(K=K, H=H, W=W, ob_in_cams=P, glctx=glctx, mesh_tensors=est.mesh_tensors)
+    sil = dep[0].cpu().numpy() > 0.001
+    iou = float((sil & mask).sum() / max(1, (sil | mask).sum()))
+    dsc = float(np.median(depth[mask])); drd = float(np.median(dep[0].cpu().numpy()[sil])) if sil.any() else float("nan")
+    cy_m, cx_m = np.argwhere(mask).mean(0); cy_s, cx_s = (np.argwhere(sil).mean(0) if sil.any() else (np.nan, np.nan))
+    print(f"  [{node}] 抠图深度中位 {dsc:.2f} m, 渲染深度中位 {drd:.2f} m, 渲染面积/抠图面积 {sil.sum()/mask.sum():.2f}, "
+          f"中心差 ({cx_s-cx_m:+.0f}, {cy_s-cy_m:+.0f}) px")
+    Pa, dists = [], []
+    for i in (0, 1):
+        Q, dd = align_ts(P[i].cpu().numpy(), mesh.vertices, dep[i].cpu().numpy(), depth, mask, K); Pa.append(Q); dists.append(dd)
+    # ★ FP 的网格不能带缩放: 把对齐出来的大小乘进网格太麻烦, 这里只取对齐后的位置, 大小差在 0.8~1.25 内由修正网络消化
+    for Q in Pa:
+        sc_ = np.cbrt(np.linalg.det(Q[:3, :3])); Q[:3, :3] /= sc_
+    P = torch.as_tensor(np.stack(Pa), dtype=torch.float, device="cuda")

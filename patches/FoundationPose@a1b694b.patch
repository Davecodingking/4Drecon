+    P, _ = est.refiner.predict(mesh=est.mesh, mesh_tensors=est.mesh_tensors, rgb=rgb, depth=depth, K=K, ob_in_cams=np.stack(cands),
+                               normal_map=None, xyz_map=xyz, glctx=glctx, mesh_diameter=est.diameter, iteration=3)
+    S, _ = est.scorer.predict(mesh=est.mesh, rgb=rgb, depth=depth, K=K, ob_in_cams=P.data.cpu().numpy(), normal_map=None,
+                              mesh_tensors=est.mesh_tensors, glctx=glctx, mesh_diameter=est.diameter)
+    S = S.cpu().numpy() if torch.is_tensor(S) else np.asarray(S); P = P.cpu().numpy()
+    best = int(np.argmax(S)); errs = [rot_err(p, gt) for p in P]
+    print(f"B. {name}: 打分 {np.round(S, 3).tolist()}, 修完后离真值 {[round(e,1) for e in errs]}°, 选了第 {best} 个 -> 离真值 {errs[best]:.1f}°, 用时 {time.time()-t0:.2f} 秒")

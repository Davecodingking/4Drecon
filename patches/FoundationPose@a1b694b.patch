+"""FP 装好之后的自检(2026-10-23): 不用官方 demo 数据。
+拿一个 SAM 3D 生成的网格, 按已知姿态用 FP 自己的渲染器渲出彩色图 + 深度 + 抠图, 再让 FP 找回来:
+  A. 官方 register(): 自己试一堆朝向, 看找回的朝向和真值差几度
+  B. 我们要用的二选一: 候选只给"真朝向"和"转 180°", 看打分是否选对; 再把两个顺序反过来喂一遍
+用法: python ours/selftest.py <网格.glb> [输出目录]"""
+import sys, os, logging, warnings
+warnings.filterwarnings("ignore")
+HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, HERE); os.chdir(HERE)
+from estimater import *
+logging.getLogger().setLevel(logging.WARNING)
+
+glb = sys.argv[1]; out = sys.argv[2] if len(sys.argv) > 2 else "/tmp/fp_selftest"; os.makedirs(out, exist_ok=True)
+m = trimesh.load(glb); mesh = m.dump(concatenate=True) if isinstance(m, trimesh.Scene) else m
+mesh.vertices -= mesh.bounds.mean(0)            # 先居中, 后面的位姿都是相对网格中心
+# ★ SAM 3D 的 glb 是 PBR 材质, FP 的 make_mesh_tensors 只认 material.image(普通贴图), 先转一下
+if isinstance(mesh.visual, trimesh.visual.texture.TextureVisuals) and not hasattr(mesh.visual.material, "image"):
+    mesh.visual.material = mesh.visual.material.to_simple()
+
+H, W = 480, 640; K = np.array([[600, 0, 320], [0, 600, 240], [0, 0, 1]], float)
+def Ry(deg):                                    # 绕网格自己的竖直轴(glb 是 y 朝上)
+    a = np.deg2rad(deg); T = np.eye(4); T[[0, 0, 2, 2], [0, 2, 0, 2]] = [np.cos(a), np.sin(a), -np.sin(a), np.cos(a)]; return T
+def Rx(deg):
+    a = np.deg2rad(deg); T = np.eye(4); T[[1, 1, 2, 2], [1, 2, 1, 2]] = [np.cos(a), -np.sin(a), np.sin(a), np.cos(a)]; return T
+cam_flip = np.diag([1, -1, -1, 1.0])            # 网格 y 朝上 -> OpenCV 相机 y 朝下、z 朝前
+gt = np.eye(4); gt[:3, 3] = [0.1, 0.15, 2.5]
+gt = gt @ cam_flip @ Rx(-20) @ Ry(35)           # 相机略微俯视, 椅子转 35°
+
+glctx = dr.RasterizeCudaContext(); mt = make_mesh_tensors(mesh)
+col, dep, _ = nvdiffrast_render(K=K, H=H, W=W, ob_in_cams=torch.as_tensor(gt[None], dtype=torch.float, device="cuda"), glctx=glctx, mesh_tensors=mt)
+rgb = (col[0].cpu().numpy() * 255).clip(0, 255).astype(np.uint8); depth = dep[0].cpu().numpy(); mask = depth > 0.001
+cv2.imwrite(f"{out}/rgb.png", rgb[..., ::-1]); print(f"渲出来: 物体占 {mask.mean()*100:.1f}% 像素, 深度中位 {np.median(depth[mask]):.2f} m")
+
+def rot_err(A, B):
+    R = A[:3, :3].T @ B[:3, :3]; return np.degrees(np.arccos(np.clip((np.trace(R) - 1) / 2, -1, 1)))
+
+est = FoundationPose(model_pts=mesh.vertices, model_normals=mesh.vertex_normals, mesh=mesh,
+                     scorer=ScorePredictor(), refiner=PoseRefinePredictor(), glctx=glctx, debug=0, debug_dir=out)
+t0 = time.time(); pose = est.register(K=K, rgb=rgb, depth=depth, ob_mask=mask, iteration=5); ta = time.time() - t0
+print(f"A. register: 朝向差 {rot_err(pose, gt):.1f}°, 位置差 {np.linalg.norm(pose[:3,3]-gt[:3,3])*100:.1f} cm, 用时 {ta:.1f} 秒, 候选 {len(est.rot_grid)} 个")
+
+# B. 二选一。est 内部的网格已按 bbox 中心居中(我们也居中过, 所以偏移是 0), 位姿直接可用
+c = est.get_tf_to_centered_mesh().cpu().numpy(); assert np.allclose(c, np.eye(4), atol=1e-5), c
+xyz = depth2xyzmap(depth, K)
+for name, cands in [("真朝向在前", [gt, gt @ Ry(180)]), ("转180°在前", [gt @ Ry(180), gt])]:

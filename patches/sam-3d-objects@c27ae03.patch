@@ -0,0 +1,110 @@
+"""烘焙进程: 收一个物体的 (高斯, 网格), 做 to_glb —— 整理网格 + 展开 UV + 100 视角渲染 +
+2500 步贴图优化 —— 写出 glb。由 run.py --bake-workers N 拉起, 不单独用。
+
+★ 为什么拆出来 (2026-09-17 实测 pedestrian r2sim, 20 个物体平均):
+  一个物体 29.5 秒 = 采样 5.9 (GPU, 要 12.9 GB 的模型) + 整理网格 5.0 (CPU)
+                     + 烘焙 18.5 (GPU, 不要模型)。
+  原来一个进程排队做, 同一时刻 GPU 上只有一个物体。烘焙不需要那份模型, 单独开进程只多占
+  约 4 GB, 一张 32 GB 的卡能同时烘几个, 采样进程不用等它。
+
+协议(一个任务一行, 全是本机管道):
+  stdin            任务文件路径(torch.save 的 dict, 见 run.py 的 _pack_job)
+  argv[1] 那个 fd  回一行 JSON: {"ready": true} / {"job":..., "ok":..., "sec":..., "err":..., "oom":...}
+  stdout/stderr    都进日志(stdout 在启动时就接到 stderr 上, 免得库里的 print 混进协议)
+stdin 关掉就退出 —— 主进程没了, 这里做完手上这个就走, 不会留孤儿。
+"""
+import json
+import os
+import sys
+import time
+import traceback
+
+# 和 notebook/inference.py 开头一样: 不设这两个, import sam3d_objects 会去跑重初始化
+os.environ.setdefault("CUDA_HOME", os.environ.get("CONDA_PREFIX", ""))
+os.environ["LIDRA_SKIP_INIT"] = "true"
+
+
+def _cls(path):
+    import importlib
+    mod, name = path.split(":")
+    return getattr(importlib.import_module(mod), name)
+
+
+def _rebuild(p, torch):
+    """按 run.py _pack 带来的类名重建。有 init_params 的(高斯)走构造函数 —— 激活函数之类的
+    是构造时挂上去的, 没打包; 其余(网格)直接填属性。张量一律回到 GPU。"""
+    cls, d = _cls(p["cls"]), p["attrs"]
+    if "init_params" in d:
+        obj = cls(**d["init_params"], device="cuda")
+    else:
+        obj = cls.__new__(cls)
+    for k, v in d.items():
+        if k in ("init_params", "device"):
+            continue
+        setattr(obj, k, v.cuda() if torch.is_tensor(v) else v)
+    return obj
+
+
+def _die_with_parent():
+    """主进程被强杀(kill -9)时 stdin 也会断, 但那要等手上这个物体烘完(几十秒, 还占着显存,
+    流水线下一步可能因此显存不够)。父进程一没就立刻退出。"""
+    import threading
+    ppid = os.getppid()
+
+    def watch():
+        while True:
+            time.sleep(2)
+            if os.getppid() != ppid:
+                os._exit(1)
+    threading.Thread(target=watch, daemon=True).start()
+
+
+def main():
+    _die_with_parent()
+    proto = os.fdopen(int(sys.argv[1]), "w", buffering=1)
+    os.dup2(2, 1)                       # 之后谁往 stdout 打印都进日志, 不进协议管道
+    sys.stdout.reconfigure(line_buffering=True)
+    wid = sys.argv[2] if len(sys.argv) > 2 else "?"
+
+    import numpy as np
+    import torch
+    from sam3d_objects.model.backbone.tdfy_dit.utils import postprocessing_utils as pu
+
+    proto.write(json.dumps({"ready": True}) + "\n")
+    for line in sys.stdin:
+        job = line.strip()
+        if not job:
+            continue
+        t0 = time.time()
+        res = {"job": job, "ok": False}
+        gs = mesh = glb = p = tmp = None
+        try:
+            p = torch.load(job, map_location="cpu", weights_only=False)
+            print(f"[烘焙 w{wid}] {p['name']} 开始", flush=True)
+            gs = _rebuild(p["gs"], torch)
+            mesh = _rebuild(p["mesh"], torch)
+            # 贴图优化每步随机挑一个视角(np.random), 原流程从来没设种子 —— 同一个物体跑两次贴图就不一样。
+            # 这里按物体的种子设死, run.py 不拆的那条路也在 to_glb 前设同一个, 两条路结果可比。
+            np.random.seed(p["seed"])
+            torch.manual_seed(p["seed"])
+            glb = pu.to_glb(gs, mesh, **p["kw"])
+            # 先写临时文件再改名: 流水线按"glb 在不在、新不新"判断要不要重做, 不能让它看到半个文件
+            tmp = p["glb"] + f".tmp{os.getpid()}.glb"
+            glb.export(tmp, file_type="glb")
+            os.replace(tmp, p["glb"])
+            res.update(ok=True, sec=round(time.time() - t0, 1))
+        except torch.cuda.OutOfMemoryError as e:
+            res.update(oom=True, err=f"CUDA OOM: {str(e)[:300]}")
+        except Exception as e:
+            res.update(err=f"{type(e).__name__}: {e}"[:500])
+            traceback.print_exc()
+        finally:
+            if tmp and os.path.exists(tmp):     # 写到一半失败的临时文件不留
+                os.remove(tmp)
+            del gs, mesh, glb, p
+            torch.cuda.empty_cache()    # 还给别的进程 —— 同一张卡上还有采样进程和别的烘焙进程
+        proto.write(json.dumps(res) + "\n")
+
+
+if __name__ == "__main__":
+    main()

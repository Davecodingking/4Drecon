@@ -0,0 +1,206 @@
+#!/usr/bin/env python
+"""第二段: 拿盘上的 images/ + masks/ 出人体网格 (SAM 3D Body [+ Diffusion-VAS 补全])。
+
+为什么单独写, 不直接用 scripts/offline_app.py:
+
+  1. ★ 他们的 inference() 是"检人 -> 跟踪 -> 出网格"一条龙, 中间不能停。
+     检人用的是 SAM 3D Body 自带的 ViTDet, 只在首帧下一次框 ——
+     中途走进画面的人永远跟不到。我们前一步用 SAM 3 的文字提示 "person" 替掉了
+     这一段 (见 body4d_track_5090.py), 所以这里只需要后半段。
+  2. ★ on_4d_generation() 遍历的是 self.RUNTIME['out_obj_ids'] 这个内存变量,
+     不是从 masks/ 里扫出来的。也就是说"哪几个人要还原"是个显式入参 ——
+     这正好是人工闸该在的位置: 跟踪跟出 6 个 id, 人看一眼决定只要 1/2/4。
+     不在名单上的 id 留在 PNG 里没关系, 不会被处理, 所以不用重写 mask。
+  3. 补全 (Diffusion-VAS) 是最贵最吃显存的一环, 拆出来才能单独开关重跑。
+
+前置: <out>/images/*.jpg + <out>/masks/*.png (八位补零, 像素值=obj_id),
+      由 body4d_track_5090.py 产出; <out>/picked.json 记人工挑的 id。
+
+用法:
+  python body4d_mesh_5090.py --dir 02_body4d目录 [--ids 1,2,4] [--completion 0|1]
+                             [--batch-size 8] [--max-occ-len 25]
+  --ids 不给就读 <dir>/picked.json; 都没有就用 masks 里出现过的全部 id。
+"""
+import argparse, json, os, sys, time
+import numpy as np
+import torch
+
+ROOT = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, ROOT)
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--dir", required=True, help="含 images/ masks/ 的目录, 也是输出目录")
+ap.add_argument("--config", default=f"{ROOT}/configs/body4d.yaml")
+ap.add_argument("--ids", default="", help="逗号分隔; 空则读 picked.json")
+ap.add_argument("--completion", type=int, default=-1,
+                help="1 开补全, 0 关, -1 用 config 里的值")
+ap.add_argument("--batch-size", type=int, default=0, help="0 = 用 config 的值")
+ap.add_argument("--max-occ-len", type=int, default=0)
+ap.add_argument("--out", default="", help="运行目录; 默认 <b1>/04_mesh_occ{0,1}")
+ap.add_argument("--individual-renders", action="store_true",
+                help="也画每个人单独一张的检查图(rendered_frames_individual/)。默认不画: 没人读, 占这一步近一半时间")
+ap.add_argument("--cam-json", default="", help="场景重建的 cameras.json。给了就用它的焦距, 不让 MoGe-2 自己估 ——\n"
+                "人离镜头多远是 SAM 3D Body 用焦距换算出来的, 焦距跟场景不一致, 人的远近就跟场景不一致")
+a = ap.parse_args()
+
+# ---------- 先定人选, 再载模型 ----------
+# 顺序是刻意的: 载模型要几十秒和十几 G 显存, 人选定不下来就别载。
+if a.ids:
+    ids = [int(x) for x in a.ids.split(",") if x.strip()]
+elif os.path.exists(f"{a.dir}/picked.json"):
+    ids = json.load(open(f"{a.dir}/picked.json"))["keep_ids"]
+    print(f"[人选] 读 picked.json: {ids}")
+else:
+    from PIL import Image
+    import glob
+    u = set()
+    for p in sorted(glob.glob(f"{a.dir}/masks/*.png")):
+        u |= set(np.unique(np.array(Image.open(p))).tolist())
+    ids = sorted(int(x) for x in u if x != 0)
+    print(f"[人选] 没有 picked.json, 用 masks 里全部 id: {ids}")
+if not ids:
+    raise SystemExit("[失败] 没有要处理的 id")
+
+from omegaconf import OmegaConf
+cfg = OmegaConf.load(a.config)
+if a.completion >= 0:
+    cfg.completion.enable = bool(a.completion)
+if a.batch_size:
+    cfg.sam_3d_body.batch_size = a.batch_size
+if a.max_occ_len:
+    cfg.max_occ_len = a.max_occ_len
+    cfg.completion.max_occ_len = a.max_occ_len
+
+# ★ 缺权重要在载模型之前报清楚, 不要等 torch.load 抛一个看不懂的 KeyError。
+need = [("SAM 3", cfg.sam3.ckpt_path), ("SAM 3D Body", cfg.sam_3d_body.ckpt_path),
+        ("MHR", cfg.sam_3d_body.mhr_path), ("MoGe-2(估焦距)", cfg.sam_3d_body.fov_path)]
+if cfg.completion.enable:
+    need += [("Diffusion-VAS mask", cfg.completion.model_path_mask),
+             ("Diffusion-VAS rgb", cfg.completion.model_path_rgb),
+             ("Depth-Anything V2", cfg.completion.model_path_depth)]
+miss = [(n, p) for n, p in need if not os.path.exists(str(p))]
+if miss:
+    for n, p in miss:
+        print(f"[缺权重] {n}: {p}")
+    raise SystemExit("[失败] 上面的权重不在。gated 的仓库要先在 HF 上申请通过")
+
+print(f"[配置] 补全={bool(cfg.completion.enable)}  batch={cfg.sam_3d_body.batch_size}  "
+      f"max_occ_len={cfg.completion.max_occ_len}  要还原的人: {ids}")
+
+# ---------- 建一个独立的运行目录, 并把 mask 重编号 ----------
+# ★ 为什么必须重编号: save_mesh_results 里写的是 f"{save_dir}/{pid+1}/..." ——
+#   pid 是 enumerate 的**位置序号**, 不是 obj_id; 而 on_4d_generation 建目录用的是
+#   out_obj_ids 的**值**。id 连续时两者恰好重合, 不连续就炸 (踩过: 挑 1/2/4,
+#   第三个人要写 mesh_4d_individual/3/ 而那个目录不存在)。
+#   他们自己一路都是 1..N 连续, 所以永远踩不到。
+# ★ 为什么另开目录而不是就地改: masks/ 是跟踪那一步的产物, 是"全部人"的真相,
+#   不该被"这一轮挑了谁"污染。另外补全开/关两轮要并排比较, 也不能互相覆盖。
+import shutil, glob as _glob
+from PIL import Image as _Image
+RUN = os.path.abspath(a.out or f"{os.path.dirname(os.path.abspath(a.dir))}/"
+                      f"04_mesh_occ{1 if (cfg.completion.enable) else 0}")
+os.makedirs(f"{RUN}/masks", exist_ok=True)
+if os.path.islink(f"{RUN}/images") or os.path.exists(f"{RUN}/images"):
+    if os.path.islink(f"{RUN}/images"):
+        os.remove(f"{RUN}/images")
+if not os.path.exists(f"{RUN}/images"):
+    os.symlink(os.path.abspath(f"{a.dir}/images"), f"{RUN}/images")   # 图不复制, 省盘
+relabel = {o: i + 1 for i, o in enumerate(ids)}                       # 1,2,4 -> 1,2,3
+from utils import DAVIS_PALETTE as _PAL
+for mp in sorted(_glob.glob(f"{a.dir}/masks/*.png")):
+    m = np.array(_Image.open(mp))
+    n = np.zeros_like(m)
+    for o, v in relabel.items():
+        n[m == o] = v
+    q = _Image.fromarray(n).convert("P"); q.putpalette(_PAL)
+    q.save(f"{RUN}/masks/{os.path.basename(mp)}")
+json.dump(dict(relabel={str(k): v for k, v in relabel.items()},
+               note="左=跟踪出的原始 id, 右=送进 SAM 3D Body 的连续 id。"
+                    "mesh_4d_individual/<右>/ 对应的是 <左> 那个人"),
+          open(f"{RUN}/relabel.json", "w"), ensure_ascii=False, indent=1)
+ids_run = sorted(relabel.values())
+print(f"[重编号] {relabel}  -> 运行目录 {RUN}")
+
+# ★ OfflineApp.__init__ 是 OmegaConf.load(config_path) —— 从**文件**重新读的,
+#   在内存里改 cfg 对它一点用没有 (踩过: --completion 0 完全没生效, 补全照开不误,
+#   然后 OOM 在 diffusers 的 attention 里)。所以覆盖必须落成一个临时 yaml 再传路径。
+cfg_path = a.config
+if (a.completion >= 0) or a.batch_size or a.max_occ_len:
+    cfg_path = f"{RUN}/_body4d_effective.yaml"
+    OmegaConf.save(cfg, cfg_path)
+    print(f"[配置] 覆盖过, 写到 {cfg_path}")
+
+# 载模型很重, 放在检查之后
+sys.argv = [sys.argv[0]]                       # offline_app 里有 argparse, 别让它吃到我们的参数
+import scripts.offline_app as _oa
+from scripts.offline_app import OfflineApp
+
+# ★ 2026-10-08: 不画"每人单独一张"的检查图(rendered_frames_individual/)。
+#   上游每算完一帧画两种图: 所有人合在一张(rendered_frames/, 体检视频和 mesh_merge 都读它, 留着),
+#   和每个人各一张(谁都不读)。后者占这一步约 44% 的时间(nfl1 40 帧实测: 推理 73s, 单人图 77s)。
+#   网格是先算好再画图的, 跳过画图不改网格。offline_app 按模块全局名调用 visualize_sample,
+#   所以改模块属性就生效, 不用动上游文件。要这些图的话加 --individual-renders。
+if not a.individual_renders:
+    _oa.visualize_sample = lambda *args, **kw: []
+
+t0 = time.time()
+app = OfflineApp(config_path=cfg_path)
+# ★ OfflineApp.__init__ 会按 gen_id() 建一个时间戳+uuid 的空目录, 这里直接改掉。
+#   他们 inference() 也是这么干的 (offline_app.py:489), 不算 hack。
+app.OUTPUT_DIR = RUN
+app.RUNTIME["out_obj_ids"] = ids_run           # ← 人工闸就是这一行 (已重编号)
+
+# ★ 焦距换成场景的。SAM 3D Body 不吃深度图, 人离镜头多远 = 焦距 x 人的真实大小 / 画面里的大小,
+#   焦距默认是 MoGe-2 一帧一帧估的, 和场景重建的相机不是一回事。pedestrian 实测 MoGe 给
+#   1465px、场景 1412px, 人的远近跟着差 3.8%。换成场景的焦距后, 剩下的差距只来自
+#   "人的真实大小"那一项, 下游(body_into_scene)再用场景深度校正。
+#   场景各帧焦距只差 1% 上下(office 626~634 @688 宽), 取中位数当常数, 按每张图的实际尺寸缩放。
+if a.cam_json:
+    _cams = json.load(open(a.cam_json))["cameras"]
+    _fy_rel = float(np.median([np.array(v["intrinsic_3x3"])[1][1] / v["input_hw"][0] for v in _cams.values()]))
+
+    class _SceneK:
+        """替掉 MoGe-2 的 FOV 估计器: 接口和 FOVEstimator.get_cam_intrinsics 一样, 返回 (1,3,3)。"""
+        def get_cam_intrinsics(self, img, **kw):
+            H, W = img.shape[:2]
+            f = _fy_rel * H                             # 方像素, 和 MoGe 那条路一样用竖直焦距
+            return torch.tensor([[[f, 0.0, W / 2.0], [0.0, f, H / 2.0], [0.0, 0.0, 1.0]]])
+
+    app.sam3_3d_body_model.fov_estimator = _SceneK()
+    print(f"[焦距] 用场景相机: f = {_fy_rel:.4f} x 图高 (1080 高时 {_fy_rel * 1080:.0f}px), 不用 MoGe-2")
+print(f"[载模型] {time.time()-t0:.0f}s  显存 {torch.cuda.memory_allocated()/2**30:.1f}G")
+
+# ★ 2026-10-08 热身: 这个进程里**第一次**调模型算出来的东西和后面的调用不一样(office 人 4 实测: 排第一算 vs 排第二算,
+#   每帧顶点差 2 mm, 个别帧 3 cm; 先用同样的输入算一遍扔掉, 再算就和排第二一样, 差 0.01 mm)。参数、buffer 都没变,
+#   是 GPU 库第一次跑那套算子走了另一条路。不热身的话"谁排第一"就影响结果: 不拆时 1 号是第一个, 按人拆开后
+#   每份的第一个人都是 —— 拆不拆结果就对不上。热身用第一批(batch 个)帧 + 第一个人, 形状和正式算的一样。
+_imgs = sorted(f"{RUN}/images/{f}" for f in os.listdir(f"{RUN}/images") if f.endswith(".jpg"))[:int(cfg.sam_3d_body.batch_size)]
+_msks = [f"{RUN}/masks/{os.path.basename(f)[:-4]}.png" for f in _imgs]
+_t = time.time()
+with torch.autocast("cuda", enabled=False):
+    _oa.process_image_with_mask(app.sam3_3d_body_model, _imgs, _msks, {}, {}, {}, {ids_run[0]: [1] * len(_imgs)})
+print(f"[热身] {time.time()-_t:.0f}s ({len(_imgs)} 帧, 人 {ids_run[0]}; 结果不用)", flush=True)
+
+t1 = time.time()
+with torch.autocast("cuda", enabled=False):    # 照抄他们 inference() 的做法
+    out = app.on_4d_generation()
+peak = torch.cuda.max_memory_allocated() / 2**30
+print(f"[出网格] {time.time()-t1:.0f}s  显存峰值 {peak:.1f}G  -> {out}")
+if not a.individual_renders:                   # 上游建好的空目录, 清掉, 免得看起来像漏画了
+    shutil.rmtree(f"{RUN}/rendered_frames_individual", ignore_errors=True)
+
+# ---------- 落一份机器可读的账 ----------
+# 每个人到底有多少帧真出了网格 —— 这是"遮挡帧掉不掉网格"的唯一硬数字,
+# 也是 补全开/关 两轮唯一能拿来对比的东西。
+res = {}
+for i in ids_run:
+    d = f"{RUN}/mesh_4d_individual/{i}"
+    res[str(i)] = len(os.listdir(d)) if os.path.isdir(d) else 0
+n_img = len(os.listdir(f"{RUN}/images"))
+json.dump(dict(ids=ids, ids_run=ids_run, relabel={str(k):v for k,v in relabel.items()}, frames=n_img, meshes_per_id=res,
+               completion=bool(cfg.completion.enable),
+               batch_size=int(cfg.sam_3d_body.batch_size),
+               peak_vram_gb=round(peak, 2), seconds=round(time.time() - t1, 1)),
+          open(f"{RUN}/mesh_report.json", "w"), ensure_ascii=False, indent=1)
+print(f"[网格数] 共 {n_img} 帧: " + "  ".join(f"id{k}:{v}" for k, v in res.items()))
+print(f"[done] -> {RUN}/{{mesh_4d_individual,rendered_frames}}/ + mesh_report.json")

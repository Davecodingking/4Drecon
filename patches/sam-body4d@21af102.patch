+++ b/body4d_report_5090.py
@@ -0,0 +1,133 @@
+#!/usr/bin/env python
+"""验收: 网格叠回原片的 mp4 + 一份交叉核对的摘要。
+
+★ 这一步存在的唯一理由是那次身份串号: 只看"每人出了多少帧网格"是看不出错的,
+  必须和"跟踪时每人有多少帧 mask"逐个对上。修补丁之前是 84/84/66, 之后是 84/66/84,
+  数字长得一样体面, 只有对照才发现前者第二个目录里前后装了两个人。
+  所以这里不做美化, 做的是**两个独立来源的数字对账**。
+
+叠加图是判断"位置和尺度准不准"的唯一办法 —— 他们自己出的 rendered_frames 是白底,
+网格再漂亮也看不出有没有对齐。
+
+用法:
+  python body4d_report_5090.py --run 04_mesh_occ0目录 --track 02_body4d目录 [--fps 8]
+"""
+import argparse, json, os, glob
+import cv2, numpy as np
+import imageio.v2 as imageio
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--run", required=True, help="含 rendered_frames/ mesh_4d_individual/ 的运行目录")
+ap.add_argument("--track", required=True, help="含 track_report.json 的跟踪目录")
+ap.add_argument("--out-dir", default=None, help="默认写到 --run 的上一级")
+ap.add_argument("--fps", type=float, default=8.0)
+ap.add_argument("--prefix", default="05")
+ap.add_argument("--alpha", type=float, default=0.6)
+ap.add_argument("--min-px", type=int, default=120,
+                help="人像高度低于它就认为是尺寸问题。SAM 3D Body 按人裁 patch 再放大")
+a = ap.parse_args()
+
+MIN_PX = a.min_px
+OUT = a.out_dir or os.path.dirname(os.path.abspath(a.run))
+tr = json.load(open(f"{a.track}/track_report.json"))
+mr = json.load(open(f"{a.run}/mesh_report.json"))
+rl = {int(k): v for k, v in json.load(open(f"{a.run}/relabel.json"))["relabel"].items()}
+
+FILES = sorted(os.listdir(f"{a.run}/images"))
+N = len(FILES)
+W, H = tr["wh"]
+
+# ---------- 1. 叠加视频 ----------
+# 白底之外的像素才算网格。他们渲染的底色是纯白, 245 这个阈值留了点抗锯齿的余量。
+EW, EH = W - W % 2, H - H % 2
+vp = f"{OUT}/{a.prefix}_mesh_overlay.mp4"
+wr = imageio.get_writer(vp, fps=a.fps, codec="libx264", quality=8,
+                        macro_block_size=1, ffmpeg_params=["-pix_fmt", "yuv420p"])
+n_ov = 0
+for fi in range(N):
+    img = cv2.imread(f"{a.run}/images/{FILES[fi]}")
+    rp = f"{a.run}/rendered_frames/{FILES[fi][:-4]}.jpg"
+    if not os.path.exists(rp):
+        continue
+    ren = cv2.imread(rp)
+    if ren.shape != img.shape:
+        ren = cv2.resize(ren, (img.shape[1], img.shape[0]))
+    fg = (ren.min(axis=2) < 245).astype(np.float32)[..., None]
+    ov = (img * (1 - a.alpha * fg) + ren * (a.alpha * fg)).astype(np.uint8)
+    cv2.putText(ov, f"#{fi}", (8, 26), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 255), 2)
+    wr.append_data(cv2.cvtColor(ov[:EH, :EW], cv2.COLOR_BGR2RGB))
+    n_ov += 1
+wr.close()
+print(f"[叠加视频] {vp}  {n_ov} 帧 @ {a.fps}fps")
+
+# ---------- 2. 对账 ----------
+# ★ 只比数量是不够的, 因为"对不上"有两个完全不同的原因, 严重性差一个数量级:
+#     网格 > mask : 这一帧这个人没有 mask 却出了网格 —— 别人的帧写进了他的目录。
+#                   这就是身份串号, 致命, 必须让 pipeline 挂掉。
+#     网格 < mask : 有 mask 却没出网格 —— SAM 3D Body 主动跳过了。
+#                   实测是人太小 (像素高不足 ~120px 它按 patch 裁完放大就是糊的),
+#                   属于分辨率不够, 提 LONG_SIDE 就能修, 不该让整条链失败。
+#   所以判据不是比数量, 而是逐帧比集合。
+cov = {int(k): v for k, v in tr["coverage"].items()}
+pf = {int(k): {int(f) for f in v} for k, v in tr["per_frame"].items()}
+mesh = {int(k): v for k, v in mr["meshes_per_id"].items()}
+bbox_h = {int(k): {int(f): v["bbox"][3] - v["bbox"][1] for f, v in d.items()}
+          for k, d in tr["per_frame"].items()}
+
+lines, fatal, warn, warn_small = [], 0, 0, 0
+lines.append(f"场景目录 {os.path.abspath(OUT)}")
+lines.append(f"帧 {N}  分辨率 {W}x{H}  补全 {'开' if mr['completion'] else '关'}  "
+             f"batch {mr['batch_size']}  显存峰值 {mr['peak_vram_gb']}G  耗时 {mr['seconds']}s")
+lines.append("")
+lines.append(f"{'原id':>5} {'新id':>5} {'mask帧':>7} {'网格帧':>7} {'像素高中位':>10}   结论")
+for oid in sorted(rl):
+    nid = rl[oid]
+    md = f"{a.run}/mesh_4d_individual/{nid}"
+    got = {int(f[:-4]) for f in os.listdir(md)} if os.path.isdir(md) else set()
+    want = pf.get(oid, set())
+    ghost = sorted(got - want)          # 有网格却没 mask -> 串号
+    skip = sorted(want - got)           # 有 mask 却没网格 -> 被跳过
+    hs = sorted(bbox_h.get(oid, {}).values())
+    hmed = hs[len(hs) // 2] if hs else 0
+    if ghost:
+        note = f"★★ 串号: {len(ghost)} 帧有网格却无 mask (如 {ghost[:5]})"
+        fatal += 1
+    elif skip:
+        sh_ = sorted(bbox_h[oid][f] for f in skip)
+        smed = sh_[len(sh_) // 2]
+        # ★ 原因不要猜。这里只报事实, 因为猜了两次都是错的:
+        #   猜 1 "人太小" —— pedestrian 从 1024 提到原生 1920 (人像高 78->148),
+        #                    跳过的还是同样那 8/1/3 帧, 一帧没救回来。证伪。
+        #   猜 2 "mask 形状不成人形" —— 量了高宽比/实心率/连通块, 和保留的帧几乎一样。证伪。
+        #   真实机制: SAM 3D Body 自己返回了全零 bbox, 被
+        #   models/sam_3d_body/notebook/utils.py 的 `bbox[0]+bbox[2] > 0` 哨兵滤掉。
+        #   也就是**模型自己拒绝出这一帧**, 拒绝的判据在它内部, 还没定位。
+        #   观察到的规律: 缺的帧是**连续的一段**且多在某个人序列的开头 (id2 缺 0-7, id5 缺 8-10)。
+        why = ("模型拒绝出网格; 该人像高中位 %d < %d, 尺寸**可能**有关但已被证伪过一次"
+               % (smed, MIN_PX) if smed < MIN_PX else "模型拒绝出网格; 该人不小, 原因未定位")
+        note = f"跳过 {len(skip)} 帧 (像素高中位 {smed}, {why})"
+        warn += 1
+        warn_small += 1 if smed < MIN_PX else 0
+    else:
+        note = "一致"
+    lines.append(f"{oid:>5} {nid:>5} {len(want):>7} {len(got):>7} {hmed:>10}   {note}")
+lines.append("")
+if warn and not fatal:
+    lines.append("※ \"跳过\" = SAM 3D Body 对那几帧返回了全零 bbox, 被下游哨兵滤掉。"
+                 "这是模型自己不出, 不是身份错误。实测提分辨率救不回来。")
+lines.append(f"跟踪告警 {len(tr['alarms'])} 处 (质心跳变/IoU断裂)。"
+             f"快速运动会误报, 看 03_track.mp4 确认颜色有没有换过。")
+lines.append(f"跟踪跟出 {tr['n_instances_raw']} 个实例, 人工挑了 {sorted(rl)}, "
+             f"丢掉 {sorted(i for i in cov if i not in rl)}")
+lines.append("")
+lines.append("边界(不是bug): 输出是 MHR 参数化裸模, 无衣服无贴图; "
+             "每帧独立相机系, 不是统一世界坐标。")
+txt = "\n".join(lines)
+sp = f"{OUT}/{a.prefix}_summary.txt"
+open(sp, "w").write(txt + "\n")
+print(txt)
+print(f"\n[摘要] {sp}")
+if fatal:
+    raise SystemExit(f"[失败] {fatal} 个人身份被写串了")
+if warn:
+    print(f"[注意] {warn} 个人有帧被跳过, 是分辨率问题不是错误, 详见上表")

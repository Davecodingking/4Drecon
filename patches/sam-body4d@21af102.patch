+++ b/body4d_track_5090.py
@@ -0,0 +1,162 @@
+#!/usr/bin/env python
+"""SAM 3 文字提示跟踪 -> 产出 SAM-Body4D 后半段要吃的 images/ + masks/。
+
+为什么要自己写这一步, 而不是直接用 scripts/offline_app.py:
+
+  1. ★ 他们的首帧检人用的是 SAM 3D Body 自带的 ViTDet
+     (offline_app.py:103 HumanDetector(name="vitdet")), 而 SAM 3D Body 的权重是
+     gated 的。也就是说没有那个权限, 连"跟踪"这半段都跑不起来 —— 因为
+     OfflineApp.__init__ 一次性构造全部模型, 缺一个就整个失败。
+     用文字提示 "person" 让 SAM 3 自己找人, 就把这层依赖摘掉了。
+  2. ★ 他们只在首帧 (准确说是"第一个检出人的帧") 下一次提示, 后面全靠传播。
+     人中途走进画面就永远不会被跟到。文字提示走的是 SAM 3 的 detect 分支,
+     每帧都会重新做语义匹配, 新进来的人有机会被捞到 (代价是 ID 可能不稳,
+     所以本脚本把每帧的 ID 变化都记下来给人看)。
+  3. 拆出来之后, 贵的那半段 (补全 + 出网格) 可以独立重跑, 不用重新跟踪。
+
+输出目录结构和 on_mask_generation() 写出来的一模一样, 所以后半段能直接接:
+    <out>/images/00000000.jpg      八位补零 —— ★ 这是他们的约定, 不是我们的四位
+    <out>/masks/00000000.png       调色板 PNG, 像素值 = obj_id (0 是背景)
+    <out>/track_report.json        每个 id 每帧的面积/质心/包围盒 + 跳变告警
+
+用法:
+  python body4d_track_5090.py --frames 帧目录 --out 输出目录 [--prompt person]
+                              [--conf 0.5] [--min-area-pct 0.1]
+"""
+import argparse, json, os, sys
+import numpy as np
+import cv2
+import torch
+from PIL import Image
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from sam3.model_builder import build_sam3_video_predictor
+from utils import DAVIS_PALETTE
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--frames", required=True, help="四位补零的 jpg 帧目录")
+ap.add_argument("--out", required=True)
+ap.add_argument("--prompt", default="person")
+ap.add_argument("--ckpt", default=os.path.expanduser("~/sam3d/sam3/checkpoints/sam3.pt"))
+ap.add_argument("--conf", type=float, default=0.5, help="new_det_thresh; 人多的场景调高")
+ap.add_argument("--min-area-pct", type=float, default=0.1,
+                help="小于画面这个百分比的实例整条丢掉。远处的路人给 SAM 3D Body 也是糊的")
+ap.add_argument("--jump-th", type=float, default=0.08, help="质心跳变告警阈值(占画面宽的比例)")
+ap.add_argument("--iou-th", type=float, default=0.20, help="相邻帧 IoU 低于它且面积没大变 -> 疑似串号")
+a = ap.parse_args()
+
+FILES = sorted(f for f in os.listdir(a.frames) if f.endswith(".jpg"))
+if not FILES:
+    raise SystemExit(f"[失败] {a.frames} 里没有 jpg")
+H, W = cv2.imread(f"{a.frames}/{FILES[0]}").shape[:2]
+print(f"[输入] {len(FILES)} 帧 {W}x{H}  提示词 '{a.prompt}'")
+
+IMG_DIR, MSK_DIR = f"{a.out}/images", f"{a.out}/masks"
+os.makedirs(IMG_DIR, exist_ok=True); os.makedirs(MSK_DIR, exist_ok=True)
+
+pred = build_sam3_video_predictor(checkpoint_path=a.ckpt)
+sid = pred.handle_request(request=dict(
+    type="start_session", resource_path=a.frames,
+    # 一级防 OOM: 视频和状态都放 CPU。84 帧 x 5 人的 bool 全图在显存里没必要
+    offload_video_to_cpu=True, offload_state_to_cpu=True))["session_id"]
+
+old = pred.model.new_det_thresh
+pred.model.new_det_thresh = a.conf
+try:
+    pred.handle_request(request=dict(type="add_prompt", session_id=sid,
+                                     frame_index=0, text=a.prompt))
+    per_frame = {}          # frame_idx -> {obj_id: mask}
+    for r in pred.handle_stream_request(request=dict(type="propagate_in_video", session_id=sid)):
+        fi = int(r["frame_index"]); o = r["outputs"]
+        d = {}
+        for k, oid in enumerate(o["out_obj_ids"].tolist()):
+            m = o["out_binary_masks"][k].astype(bool)
+            if m.any():
+                d[int(oid)] = m
+        per_frame[fi] = d
+        if fi % 20 == 0:
+            print(f"  帧 {fi:3d}: {len(d)} 个实例  (显存 {torch.cuda.memory_allocated()/2**30:.1f}G)",
+                  flush=True)
+finally:
+    pred.model.new_det_thresh = old
+    pred.handle_request(request=dict(type="close_session", session_id=sid))
+
+# ---------- 按总面积筛掉太小的实例 ----------
+# 逐帧筛会让一个人忽有忽无; 按"他出现过的最大面积"整条决定, 要么全留要么全丢。
+area_max = {}
+for d in per_frame.values():
+    for oid, m in d.items():
+        area_max[oid] = max(area_max.get(oid, 0), int(m.sum()))
+th = a.min_area_pct / 100.0 * W * H
+keep = sorted(o for o, v in area_max.items() if v >= th)
+drop = sorted(o for o, v in area_max.items() if v < th)
+print(f"[筛选] 共 {len(area_max)} 个实例; 留 {len(keep)} 个, "
+      f"丢 {len(drop)} 个(最大面积不到画面的 {a.min_area_pct}%)")
+
+# ★ 重新编号成 1..N。0 在调色板 PNG 里是背景, 不能拿来当 id。
+remap = {o: i + 1 for i, o in enumerate(keep)}
+
+# ---------- 落盘 + 统计 ----------
+stat = {v: {} for v in remap.values()}
+for fi, fn in enumerate(FILES):
+    img = cv2.imread(f"{a.frames}/{fn}")
+    msk = np.zeros((H, W), np.uint8)
+    for oid, m in per_frame.get(fi, {}).items():
+        if oid not in remap:
+            continue
+        nid = remap[oid]
+        msk[m] = nid
+        ys, xs = np.nonzero(m)
+        stat[nid][fi] = dict(area=int(m.sum()),
+                             cx=float(xs.mean()), cy=float(ys.mean()),
+                             bbox=[int(xs.min()), int(ys.min()), int(xs.max()), int(ys.max())])
+    cv2.imwrite(f"{IMG_DIR}/{fi:08d}.jpg", img, [cv2.IMWRITE_JPEG_QUALITY, 95])
+    p = Image.fromarray(msk).convert("P"); p.putpalette(DAVIS_PALETTE)
+    p.save(f"{MSK_DIR}/{fi:08d}.png")
+
+# ---------- 串号 / 跳变告警 ----------
+# 两个独立的判据, 都是"这一帧的 mask 不可能是上一帧那个人自然移动过来的":
+#   质心跳变: 7.5fps 下打架的人一帧最多移动画面宽的 2~4%, 8% 是宽松的margin
+#   IoU 断裂 + 面积没变: 形状没变却整个挪走了 —— 这是换人, 不是运动
+alarms = []
+for nid, fr in stat.items():
+    ks = sorted(fr)
+    for p_, c in zip(ks, ks[1:]):
+        if c - p_ != 1:
+            continue                       # 中间断了帧, 不比
+        A, B = fr[p_], fr[c]
+        dx = abs(A["cx"] - B["cx"]) / W
+        dy = abs(A["cy"] - B["cy"]) / H
+        d = max(dx, dy)
+        ar = B["area"] / max(A["area"], 1)
+        if d > a.jump_th:
+            alarms.append(dict(id=nid, frame=c, kind="质心跳变",
+                               move_pct=round(d * 100, 1), area_ratio=round(ar, 2)))
+        elif 0.6 < ar < 1.6:
+            # 面积没大变, 再查 IoU。IoU 低说明位置完全不重叠 = 换了个人
+            ma = per_frame[p_]; mb = per_frame[c]
+            oa = [o for o, v in remap.items() if v == nid]
+            if oa and oa[0] in ma and oa[0] in mb:
+                x, y = ma[oa[0]], mb[oa[0]]
+                iou = float((x & y).sum()) / max(float((x | y).sum()), 1)
+                if iou < a.iou_th:
+                    alarms.append(dict(id=nid, frame=c, kind="IoU断裂",
+                                       iou=round(iou, 3), area_ratio=round(ar, 2)))
+
+rep = dict(frames=len(FILES), wh=[W, H], prompt=a.prompt, conf=a.conf,
+           n_instances_raw=len(area_max), kept_ids=list(remap.values()),
+           dropped_raw_ids=drop, remap={str(k): v for k, v in remap.items()},
+           coverage={str(k): len(v) for k, v in stat.items()},
+           alarms=alarms,
+           per_frame={str(k): {str(f): v for f, v in d.items()} for k, d in stat.items()})
+json.dump(rep, open(f"{a.out}/track_report.json", "w"), ensure_ascii=False, indent=1)
+
+print(f"\n[覆盖] 共 {len(FILES)} 帧")
+for nid in sorted(stat):
+    n = len(stat[nid]); ks = sorted(stat[nid])
+    print(f"   id {nid}: {n:3d}/{len(FILES)} 帧 ({n/len(FILES)*100:3.0f}%)  "
+          f"帧 {ks[0]}~{ks[-1]}  最大面积 {max(v['area'] for v in stat[nid].values())/(W*H)*100:.1f}%")
+print(f"[告警] {len(alarms)} 处疑似串号/跳变" + ("" if not alarms else ":"))
+for x in alarms[:12]:
+    print("   ", x)
+print(f"[done] -> {a.out}/{{images,masks}}/  + track_report.json")

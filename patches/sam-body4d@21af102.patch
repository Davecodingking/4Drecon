+#!/usr/bin/env python
+"""找出遮挡最重的帧, 出对比图。用来判断"要不要开 Diffusion-VAS 补全"。
+
+为什么需要这一步 —— "遮挡严不严重"不能靠翻视频找感觉, 得有个能排序的量:
+
+    人框重叠 = 两人包围盒交集 / 较小者。1.00 就是一个人的框完全落在另一个里面
+    面积缩水 = 这一帧的 mask 面积相对他自己中位面积掉了多少
+
+两个量都指向同一件事: 这个人这一帧被别人盖掉了多少。
+
+出的图是三列 —— 原片 | SAM 3 给的 mask | 出来的网格。★ 中间那列是重点:
+遮挡下 mask 不是"变小", 是被遮挡物横穿切成互不相连的碎片; 而右边的网格无论
+mask 剩多少永远是完整一个人。差额就是模型编出来的部分。
+
+用法:
+  python body4d_occ_5090.py --run 04_mesh_occ0目录 --track 02_body4d目录
+                            [--top 3] [--id 原id] [--prefix 06]
+  --id 不给就自动选"被盖得最狠"的那个人。
+"""
+import argparse, itertools, json, os
+import cv2, numpy as np
+from PIL import Image
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--run", required=True)
+ap.add_argument("--track", required=True)
+ap.add_argument("--out-dir", default=None)
+ap.add_argument("--top", type=int, default=3, help="出几帧")
+ap.add_argument("--id", type=int, default=0, help="盯哪个原id; 0=自动挑被盖最狠的")
+ap.add_argument("--prefix", default="06")
+a = ap.parse_args()
+
+OUT = a.out_dir or os.path.dirname(os.path.abspath(a.run))
+tr = json.load(open(f"{a.track}/track_report.json"))
+rl = {int(k): v for k, v in json.load(open(f"{a.run}/relabel.json"))["relabel"].items()}
+W, H = tr["wh"]
+pf = {int(k): {int(f): v for f, v in d.items()} for k, d in tr["per_frame"].items()
+      if int(k) in rl}
+med = {k: float(np.median([v["area"] for v in d.values()])) for k, d in pf.items()}
+
+
+def cover(b1, b2):
+    """交集 / 较小者。衡量"小的那个被盖了多少", 比 IoU 更贴题 ——
+    IoU 会因为两人体型差异被稀释, 而我们关心的是被盖的那个。"""
+    x0, y0 = max(b1[0], b2[0]), max(b1[1], b2[1])
+    x1, y1 = min(b1[2], b2[2]), min(b1[3], b2[3])
+    if x1 <= x0 or y1 <= y0:
+        return 0.0
+    ar = lambda z: max((z[2] - z[0]) * (z[3] - z[1]), 1)
+    return (x1 - x0) * (y1 - y0) / min(ar(b1), ar(b2))
+
+
+# 逐帧算, 记下"这一帧最惨的是谁、惨到什么程度"
+rows = []
+for f in range(tr["frames"]):
+    ps = [(k, pf[k][f]) for k in pf if f in pf[k]]
+    worst_id, worst = None, 0.0
+    for (ka, va), (kb, vb) in itertools.combinations(ps, 2):
+        c = cover(va["bbox"], vb["bbox"])
+        # 被盖的是面积小的那个
+        vic = ka if va["area"] <= vb["area"] else kb
+        if c > worst:
+            worst, worst_id = c, vic
+    shrink = max((1 - pf[k][f]["area"] / med[k] for k, _ in ps), default=0.0)
+    rows.append(dict(frame=f, cover=worst, victim=worst_id, shrink=max(shrink, 0.0)))
+
+rows.sort(key=lambda r: -(r["cover"] * 0.6 + r["shrink"] * 0.4))
+top = rows[:a.top]
+OID = a.id or (top[0]["victim"] or sorted(pf)[0])
+print(f"[遮挡排行] 盯 原id{OID} (新id{rl[OID]})")
+print(f"{'帧':>4} {'人框重叠':>8} {'面积缩水':>8}")
+for r in top:
+    print(f"{r['frame']:>4} {r['cover']:>8.2f} {r['shrink']:>8.2f}")
+
+# 只取这个人真的有 mask 的帧, 按"他自己缩水多少"重排
+cand = [r["frame"] for r in rows if r["frame"] in pf[OID]]
+cand.sort(key=lambda f: pf[OID][f]["area"] / med[OID])
+picks = sorted(cand[:a.top])
+if not picks:
+    raise SystemExit(f"[失败] 原id{OID} 没有任何帧")
+
+HW, HH = 190, 205
+tiles = []
+for fi in picks:
+    img = cv2.imread(f"{a.run}/images/{fi:08d}.jpg")
+    msk = np.array(Image.open(f"{a.track}/masks/{fi:08d}.png")) == OID
+    rp = f"{a.run}/rendered_frames/{fi:08d}.jpg"
+    ren = cv2.imread(rp) if os.path.exists(rp) else np.full_like(img, 255)
+    if ren.shape != img.shape:
+        ren = cv2.resize(ren, (img.shape[1], img.shape[0]))
+    x0, y0, x1, y1 = pf[OID][fi]["bbox"]
+    cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
+    X0, Y0 = max(0, cx - HW), max(0, cy - HH)
+    X1, Y1 = min(img.shape[1], cx + HW), min(img.shape[0], cy + HH)
+    crop = lambda z: cv2.resize(z[Y0:Y1, X0:X1], (2 * HW, 2 * HH))
+    hi = (msk[..., None] * np.array([60, 230, 230], np.uint8) +
+          (~msk)[..., None] * (img // 3)).astype(np.uint8)
+    pct = pf[OID][fi]["area"] / med[OID] * 100
+    # ★ 标签一律英文: cv2.putText 不支持中文, 中文会画成一串问号
+    panes = [(crop(img), f"#{fi} frame"),
+             (crop(hi), f"mask {pct:.0f}% of median"),
+             (crop(ren), "mesh (always complete)")]
+    row = []
+    for z, t in panes:
+        cv2.putText(z, t, (6, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 255), 2)
+        row.append(z)
+    tiles.append(np.hstack(row))
+    print(f"  帧 {fi}: mask 只剩中位面积的 {pct:.0f}%")
+
+sheet = np.vstack(tiles)
+sp = f"{OUT}/{a.prefix}_occlusion.jpg"
+cv2.imwrite(sp, sheet, [cv2.IMWRITE_JPEG_QUALITY, 90])
+json.dump(dict(watch_orig_id=OID, watch_run_id=rl[OID], frames=picks,
+               ranking=[{k: (round(v, 3) if isinstance(v, float) else v)
+                         for k, v in r.items()} for r in rows[:10]]),
+          open(f"{OUT}/{a.prefix}_occlusion.json", "w"), ensure_ascii=False, indent=1)
+print(f"[done] {sp}  ({sheet.shape[1]}x{sheet.shape[0]})")

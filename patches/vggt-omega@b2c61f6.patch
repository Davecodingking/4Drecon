+        pose_check.write(d, pc, "vggt_omega_geom.py --pose-into: VGGT-Ω 几何 + DA3 置信度, 坏帧的点没进 points.ply")
+        bad_idx = [names.index(x) for x in pc["坏帧"]]
+        for i in bad_idx:
+            valid[i * per:(i + 1) * per] = False
+    pts = []
+    for i in range(N):
+        x = (u - K_v[i, 0, 2]) / K_v[i, 0, 0] * depth[i]
+        y = (v - K_v[i, 1, 2]) / K_v[i, 1, 1] * depth[i]
+        Xc = np.stack([x, y, depth[i]], -1).reshape(-1, 3)
+        c2w = np.linalg.inv(w2c[i])
+        pts.append((Xc @ c2w[:3, :3].T + c2w[:3, 3]).astype(np.float32))
+    pts = np.concatenate(pts)[valid]; cols = rgb_v.reshape(-1, 3)[valid]
+    if len(pts) > a.max_points:

+
+    if a.infer_only:
+        save_infer(a.cache, names, w2c, K, depth, conf_raw, rgb, t_load, t_inf, peak)
+        print(f"[done] 推理结果 -> {a.cache}  (等 DA3 跑完, 用 --pose-into --cache 混合)")
+        return
+    if a.pose_into:
+        pose_into(a, names, w2c, K, depth, conf_raw, rgb, t_load, t_inf, peak)
+        if a.cache and os.path.exists(a.cache):
+            os.remove(a.cache)
+        return
+
+    # 3. 天空
+    t2 = time.time()
+    if a.no_sky:
+        sky = np.zeros((N, H, W), bool)
+    else:
+        sky = sky_masks(paths, (H, W))
+        os.makedirs(f"{a.out}/sky", exist_ok=True)
+        for n, s in zip(names, sky):
+            cv2.imwrite(f"{a.out}/sky/{Path(n).stem}.png", s.astype(np.uint8) * 255)
+    t_sky = time.time() - t2
+
+    # 4. 尺度: 先把深度落盘(Metric3D 那边要读), 定完倍数再覆盖
+    scale, scale_info = 1.0, None
+    if a.scale != "none":
+        sd = f"{a.out}/_scale"; os.makedirs(sd, exist_ok=True)
+        pick = np.unique(np.linspace(0, N - 1, min(a.scale_frames, N)).round().astype(int))
+        frames = []
+        for i in pick:
+            ok = ~sky[i] & (conf_raw[i] >= np.percentile(conf_raw[i], 30))   # 只比非天空、置信度前 70% 的像素
+            np.save(f"{sd}/{i:04d}_depth.npy", depth[i]); np.save(f"{sd}/{i:04d}_valid.npy", ok)
+            fx0 = a.fx if a.fx else float(K[i, 0, 0]) * W0 / W              # 换算到原图像素
+            frames.append(dict(image=paths[i], fx=fx0, depth=f"{sd}/{i:04d}_depth.npy", valid=f"{sd}/{i:04d}_valid.npy"))
+        job = dict(model=a.scale, out=f"{sd}/result.json", frames=frames)
+        json.dump(job, open(f"{sd}/job.json", "w"), indent=1)
+        r = subprocess.run([METRIC_PY, f"{HERE}/metric3d_scale.py", f"{sd}/job.json"])
+        if r.returncode:
+            raise SystemExit(f"[尺度] metric3d_scale.py 失败, 退出码 {r.returncode}")
+        for i in pick:                                                    # 临时文件只在定尺度时有用
+            os.remove(f"{sd}/{i:04d}_depth.npy"); os.remove(f"{sd}/{i:04d}_valid.npy")
+        scale_info = json.load(open(f"{sd}/result.json"))
+        scale = scale_info["scale"]
+        depth *= scale
+        w2c[:, :3, 3] *= scale          # 世界整体放大: 旋转不变, 平移同乘
+
+    # 5. 置信度换算
+    conf = to_da3_conf(conf_raw, sky)
+    for i, n in enumerate(names):
+        np.save(f"{a.out}/depth/{Path(n).stem}_depth.npy", depth[i].astype(np.float32))
+        np.save(f"{a.out}/depth/{Path(n).stem}_conf.npy", conf[i])
+
+    # 6. 坏帧 + 点云
+    per = H * W
+    v, u = np.mgrid[0:H, 0:W]
+    valid = np.isfinite(depth).reshape(-1) & (depth.reshape(-1) > 0) & ~sky.reshape(-1)
+    cf = conf.reshape(-1)
+    if a.conf_min is not None:
+        valid &= cf >= a.conf_min
+    elif a.conf_percentile > 0:
+        for i in range(N):
+            sl = slice(i * per, (i + 1) * per)
+            if valid[sl].any():
+                valid[sl] &= cf[sl] >= np.percentile(cf[sl][valid[sl]], a.conf_percentile)
+    bad_path = f"{a.out}/bad_frames.json"
+    bad_idx = []
+    if a.no_pose_check:
+        if os.path.exists(bad_path):
+            os.remove(bad_path)
+    else:
+        sys.path.insert(0, POSE_CHECK_DIR)
+        import pose_check
+        pc = pose_check.find_bad_frames(names, depth, w2c, K, **pose_check.PARAMS)
+        pose_check.write(a.out, pc, "vggt_omega_geom.py 推理后当场筛, 坏帧的点没进 points.ply")
+        bad_idx = [names.index(x) for x in pc["坏帧"]]
+        for i in bad_idx:
+            valid[i * per:(i + 1) * per] = False
+        print(f"[坏位姿] {len(bad_idx)}/{N} 帧: {pc['坏帧']}")
+    pts = []
+    for i in range(N):
+        x = (u - K[i, 0, 2]) / K[i, 0, 0] * depth[i]
+        y = (v - K[i, 1, 2]) / K[i, 1, 1] * depth[i]
+        Xc = np.stack([x, y, depth[i]], -1).reshape(-1, 3)
+        c2w = np.linalg.inv(w2c[i])
+        pts.append((Xc @ c2w[:3, :3].T + c2w[:3, 3]).astype(np.float32))
+    pts = np.concatenate(pts)[valid]
+    cols = rgb.reshape(-1, 3)[valid]
+    if len(pts) > a.max_points:
+        sel = np.random.choice(len(pts), a.max_points, replace=False)
+        pts, cols = pts[sel], cols[sel]
+    write_ply(f"{a.out}/points.ply", pts, cols)
+
+    cams = {}
+    for i, n in enumerate(names):
+        cams[n] = dict(extrinsic_w2c_4x4=w2c[i].tolist(), intrinsic_3x3=K[i].tolist(),
+                       camera_center_world=np.linalg.inv(w2c[i])[:3, 3].tolist(), input_hw=[int(H), int(W)],
+                       mean_conf=float(conf[i].mean()))
+    json.dump(dict(
+        convention="OpenCV (x right, y down, z forward); world = camera frame of first image; "
+                   + ("METRIC via " + a.scale if a.scale != "none" else "NOT metric (raw VGGT-Omega scale)"),
+        geom_backend="vggt_omega", model=ckpt, process_res=a.res,
+        is_metric=int(a.scale != "none"), scale_factor=scale, scale_source=a.scale,
+        given_fx=a.fx, sky_mask=not a.no_sky, conf="VGGT-Omega conf rank-mapped to DA3 scale (da3_conf_ref.json); sky = 0",
+        source=a.images, images_used=names, images_skipped=[], cameras=cams),
+        open(f"{a.out}/cameras.json", "w"), indent=2)
+
+    lo, hi = np.percentile(pts, 1, 0), np.percentile(pts, 99, 0)
+    cen = np.array([cams[n]["camera_center_world"] for n in names])
+    s = (f"frames: {N} (skipped 0)\nprocessed HxW: {H}x{W}\n"
+         f"points: {len(pts)} (conf filter: " + (f"min {a.conf_min}" if a.conf_min is not None else f"percentile {a.conf_percentile} per-frame") + ")\n"
+         f"backend: VGGT-Omega {ckpt}; scale {a.scale} x{scale:.4f}"
+         + (f" (from {scale_info['frames_used']} frames, per-frame spread {scale_info['per_frame_spread_pct']}%)" if scale_info else "") + "\n"
+         f"scene bbox (1-99%) min {lo.round(3).tolist()} max {hi.round(3).tolist()} extent {(hi-lo).round(3).tolist()} m\n"
+         f"camera centers extent {(cen.max(0)-cen.min(0)).round(3).tolist()} m\n"
+         f"time: model load {t_load:.1f}s, inference {t_inf:.2f}s, peak VRAM {peak:.2f} GB; sky {t_sky:.1f}s"
+         + (f"; metric3d load {scale_info['load_s']}s infer {scale_info['infer_s']}s VRAM {scale_info['peak_vram_GB']} GB" if scale_info else "") + "\n"
+         f"bad pose frames (not in points.ply): " + ("check disabled" if a.no_pose_check else f"{len(bad_idx)} {[names[i] for i in bad_idx]}") + "\n")
+    s += "per-frame: name  kept%  sky%  median_depth_m\n" + "".join(
+        f"  {n}  {valid[i*per:(i+1)*per].mean()*100:5.1f}%  {sky[i].mean()*100:5.1f}%  {np.median(depth[i]):5.2f}\n"
+        for i, n in enumerate(names))
+    open(f"{a.out}/summary.txt", "w").write(s)
+    print(s.split("per-frame")[0])
+
+
+if __name__ == "__main__":
+    main()

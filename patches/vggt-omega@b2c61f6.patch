+++ b/tools/metric3d_scale.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python
+"""给 VGGT-Ω 定米制尺度: 抽几帧跑 Metric3D v2(单图米制深度), 和 VGGT-Ω 的深度逐像素比, 取中位数。
+由 vggt_omega_geom.py 调用, 跑在 metricdepth 环境(/mnt/nvme/jincheng/envs/metricdepth)。
+
+  python metric3d_scale.py <job.json>
+job.json: {"model": "metric3d_l"|"metric3d_g2", "out": 结果json,
+           "frames": [{"image": 原图, "fx": 原图像素焦距, "depth": VGGT深度npy, "valid": 有效像素npy(bool)}, ...]}
+结果: {"scale": 倍数, "per_frame": [...], ...}   VGGT-Ω 深度 × scale = 米
+
+★ 为什么是这个做法(devLog/devlog_9.16.md 第 10 节, ithor312 有真值):
+  - VGGT-Ω 自己不是米制(ithor312 上小了 2.2~2.4 倍), 要外借一把"尺子"。
+  - 6 个米制模型里 Metric3D v2 最准: 整体倍数误差 Large 0.6%、Giant2 2.2%(DA3 Nested 11.4%)。
+  - 但单张图的倍数上下浮动约 20%, 所以只能取多帧的中位数, 不能拿一帧定。
+  - Metric3D 必须给焦距; 用 VGGT-Ω 自己估的(ithor312 上误差 0.6%, 比 DA3 的 1.5% 还准)。
+★ 只比"两边都靠谱"的像素: valid 由调用方给(非天空 + VGGT-Ω 置信度前 70%), 这里再去掉
+  Metric3D 输出 <=0 或超过 200 米的点。
+★ mmcv: Metric3D 的 torch.hub 代码 import 了 mmcv.utils 里几个配置工具, 这里用 shims/ 下的
+  mmengine 顶替, 不编 mmcv。权重在 TORCH_HOME(/mnt/nvme/jincheng/torch_cache), 离线加载。
+"""
+import json, os, sys, time
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "shims"))
+os.environ.setdefault("TORCH_HOME", "/mnt/nvme/jincheng/torch_cache")   # 必须在 import torch 之前
+import numpy as np, torch, cv2
+
+HUB_DIR = "/mnt/nvme/jincheng/torch_cache/hub/yvanyin_metric3d_main"
+HUB_NAME = {"metric3d_l": "metric3d_vit_large", "metric3d_g2": "metric3d_vit_giant2"}
+IN_H, IN_W = 616, 1064   # ViT 版 Metric3D 的固定输入尺寸(官方 hubconf 示例)
+MEAN = [123.675, 116.28, 103.53]
+STD = [58.395, 57.12, 57.375]
+
+
+def infer(model, img, fx):
+    """img: HxWx3 RGB uint8(原图), fx: 原图像素焦距。返回原图大小的米制 z 深度。
+    做法照官方示例: 等比缩放塞进 616x1064, 四周用均值色补齐, 出来的深度是按"焦距 1000"算的,
+    乘 fx*缩放/1000 换回真实焦距。"""
+    H, W = img.shape[:2]
+    sc = min(IN_H / H, IN_W / W)
+    r = cv2.resize(img, (int(W * sc), int(H * sc)), interpolation=cv2.INTER_LINEAR)
+    h, w = r.shape[:2]
+    pt, pl = (IN_H - h) // 2, (IN_W - w) // 2
+    r = cv2.copyMakeBorder(r, pt, IN_H - h - pt, pl, IN_W - w - pl, cv2.BORDER_CONSTANT, value=MEAN)
+    t = torch.from_numpy(r).permute(2, 0, 1).float().cuda()
+    t = (t - torch.tensor(MEAN, device="cuda")[:, None, None]) / torch.tensor(STD, device="cuda")[:, None, None]
+    d, _, _ = model.inference({"input": t[None]})
+    d = d.squeeze()[pt:pt + h, pl:pl + w]
+    d = torch.nn.functional.interpolate(d[None, None], (H, W), mode="bilinear").squeeze()
+    return (d * (fx * sc / 1000.0)).float().cpu().numpy()
+
+
+def main():
+    job = json.load(open(sys.argv[1]))
+    t0 = time.time()
+    model = torch.hub.load(HUB_DIR, HUB_NAME[job["model"]], source="local", pretrain=True).cuda().eval()
+    t_load = time.time() - t0
+    torch.cuda.reset_peak_memory_stats()
+    t1 = time.time()
+    per = []
+    with torch.inference_mode():
+        for f in job["frames"]:
+            img = cv2.cvtColor(cv2.imread(f["image"]), cv2.COLOR_BGR2RGB)
+            vd = np.load(f["depth"])
+            ok = np.load(f["valid"])
+            md = cv2.resize(infer(model, img, f["fx"]), (vd.shape[1], vd.shape[0]), interpolation=cv2.INTER_LINEAR)
+            m = ok & np.isfinite(md) & (md > 0) & (md < 200) & np.isfinite(vd) & (vd > 0)
+            if m.sum() < 1000:          # 几乎全是天空 / 全被筛掉的帧不参与
+                per.append(None); continue
+            per.append(float(np.median(md[m] / vd[m])))
+    t_inf = time.time() - t1
+    good = [p for p in per if p is not None]
+    if not good:
+        raise SystemExit("[尺度] 没有一帧能用来定尺度")
+    s = float(np.median(good))
+    res = dict(model=job["model"], scale=s, frames_used=len(good), frames_total=len(per),
+               per_frame=per, per_frame_spread_pct=round(float(np.std(good) / np.mean(good) * 100), 1),
+               load_s=round(t_load, 1), infer_s=round(t_inf, 1),
+               peak_vram_GB=round(torch.cuda.max_memory_allocated() / 1e9, 2))
+    json.dump(res, open(job["out"], "w"), indent=1)
+    print(f"[尺度] {job['model']}: ×{s:.4f}  ({len(good)}/{len(per)} 帧, 单帧浮动 {res['per_frame_spread_pct']}%)"
+          f"  装载 {t_load:.1f}s 推理 {t_inf:.1f}s 显存 {res['peak_vram_GB']}GB")
+
+
+if __name__ == "__main__":
+    main()

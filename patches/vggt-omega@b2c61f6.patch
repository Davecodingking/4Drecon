+def load_infer(path, names):
+    """--pose-into --cache: 读提前算好的推理结果。帧列表必须和这次要用的一模一样(顺序也是) —— 多视角模型换一批帧
+    结果就不一样, 位姿又是按顺序对的。对不上、文件不在、读不出来, 一律返回 None, 调用方照老办法现算。"""

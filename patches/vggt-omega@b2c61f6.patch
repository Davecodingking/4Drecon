+def pose_into(a, names, w2c_v, K_v, depth_v, conf_v, rgb_v, t_load, t_inf, peak):
+    """混合模式(室内默认 GEOM=vggt_da3): 几何全用 VGGT-Ω, DA3 只当"掩码 + 尺子"。
+    --out 是 da3_to_ply.py 刚写好的目录; 这里把它的位姿/深度/内参换成 VGGT-Ω 的, 置信度沿用 DA3 的。
+
+    为什么这样分工(ithor312 对真值, analysis_9.17_vggt_omega/hybrid_vs_gt.py, 点到真值表面的距离):
+      纯 DA3                          中位 6.1 cm / 90 分位 20.3 cm, pose_check 剔 15 帧
+      VGGT-Ω 位姿 + DA3 深度          2.9 / 11.5 cm, 剔 15 帧(DA3 各帧深度尺度不一, 和别人的位姿对不上)
+      VGGT-Ω 位姿+深度, DA3 置信度掩码  1.9 / 4.6 cm, 剔 1 帧   <- 这里的做法
+    为什么还要 DA3: cyberpunk 实测 VGGT-Ω 在黑区给出几十~几百米的假深度且自己的置信度不低;
+      DA3 把这些区域置信度压到下限 1.0。拿 DA3 置信度当掩码, >30 m 的假深度 99.2% 被盖掉。
+      VGGT-Ω 也不是米制, 顺手拿 DA3 深度当尺子(室内只有这一把现成的; ithor312 上 DA3 偏 11%)。
+
+    做法:
+      1. 尺度: 两边深度逐像素比(DA3 置信度 >=2 且 VGGT-Ω 置信度前 70% 的像素), 逐帧中位数再取中位数。
+         VGGT-Ω 深度和相机平移都乘上它。
+      2. 置信度: DA3 的置信度缩到 VGGT-Ω 分辨率(最近邻), 下游门槛(CONF_MIN / OBJ_CONF)含义不变。
+         另外两边深度差 2 倍以上的像素置信度记 0 —— 兜住掩码漏掉的黑区残余(ithor312 上一个像素都不丢)。
+      3. 覆盖 cameras.json(位姿 + 内参 + input_hw)和 depth/*.npy; DA3 原件备份到 _da3_orig/。
+      4. 用新几何重跑坏帧筛选, 重拼 points.ply。
+    ★ DA3 的天空掩码没落盘, 这里拿不到; 室内靠置信度门槛(天空/黑区 = 1.0)兜住, 所以只给室内用。"""
+    import shutil
+    d = a.out
+    bk = f"{d}/_da3_orig"
+    meta = json.load(open(f"{d}/cameras.json"))
+    if meta.get("geom_backend") == "vggt_da3":
+        # 同一目录再跑一次: 当前那份已被换过, 从备份的 DA3 原件重来
+        meta = json.load(open(f"{bk}/cameras.json"))
+    else:
+        # da3_to_ply.py 刚写的原件: 每次都覆盖备份
+        if os.path.exists(bk):
+            shutil.rmtree(bk)
+        os.makedirs(bk)
+        json.dump(meta, open(f"{bk}/cameras.json", "w"), indent=2)
+        shutil.copytree(f"{d}/depth", f"{bk}/depth")
+    cams = meta["cameras"]
+    N, H, W = depth_v.shape
+
+    ratios, dconf, dsz = [], [], []
+    for i, n in enumerate(names):
+        s = Path(n).stem
+        da = np.load(f"{bk}/depth/{s}_depth.npy"); ca = np.load(f"{bk}/depth/{s}_conf.npy")
+        da = cv2.resize(da, (W, H), interpolation=cv2.INTER_LINEAR)
+        ca = cv2.resize(ca, (W, H), interpolation=cv2.INTER_NEAREST)
+        dsz.append(da); dconf.append(ca)
+        vd = depth_v[i]
+        m = (ca >= 2.0) & (conf_v[i] >= np.percentile(conf_v[i], 30)) & (da > 0) & (vd > 0) & np.isfinite(da) & np.isfinite(vd)
+        if m.sum() >= 1000:
+            ratios.append(float(np.median(da[m] / vd[m])))
+    if not ratios:
+        raise SystemExit("[混合] 没有一帧能对上尺度")
+    scale = float(np.median(ratios))
+    spread = float(np.std(ratios) / np.mean(ratios) * 100)
+    depth = depth_v * scale
+    w2c = w2c_v.copy(); w2c[:, :3, 3] *= scale
+    conf = np.stack(dconf).astype(np.float32)

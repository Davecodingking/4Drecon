+        del model, pred, imgs
+        torch.cuda.empty_cache()                                              # 显存让给下一步的 Metric3D
+        w2c = np.tile(np.eye(4), (len(names), 1, 1)); w2c[:, :3] = ext
+    N, H, W = depth.shape

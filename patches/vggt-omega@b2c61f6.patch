+    json.dump(meta, open(f"{d}/cameras.json", "w"), indent=2)
+
+    per = H * W
+    v, u = np.mgrid[0:H, 0:W]
+    valid = (depth.reshape(-1) > 0) & np.isfinite(depth).reshape(-1)
+    if a.conf_min is not None:
+        valid &= conf.reshape(-1) >= a.conf_min
+    else:
+        valid &= conf.reshape(-1) > 0
+    bad_idx = []
+    if a.no_pose_check:
+        if os.path.exists(f"{d}/bad_frames.json"):
+            os.remove(f"{d}/bad_frames.json")
+    else:

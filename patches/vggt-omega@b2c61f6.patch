@@ -0,0 +1,74 @@
+#!/usr/bin/env python
+"""两份几何结果(DA3 的 02_da3 和 VGGT-Ω 后端的 02_da3)逐帧对账, 没有真值时用。
+  python compare_geom.py --a DA3目录 --b VGGT目录 [--a-scale 1.336] [--sky b目录/sky]
+输出:
+  深度倍数  b/a 的逐帧中位数(非天空像素), 以及它的整体中位数和帧间浮动
+  位姿      两条轨迹做相似变换对齐后, 相机位置残差 / 逐帧朝向差(度)
+  坏帧      各自 bad_frames.json 里的数量(没有就当场用 pose_check 算)
+--a-scale: a 那份再乘的倍数。室外 DA3 后面还有 world_scale 按物体常识尺寸校过一次,
+  传那个 k 进来, 就是拿"常识尺度"当参照来看 b 准不准。
+sam3d 环境(只用 numpy + cv2)。
+"""
+import argparse, json, os, sys
+import numpy as np, cv2
+sys.path.insert(0, os.path.expanduser("~/sam3d/data/outdoor/scripts"))
+import pose_check
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--a", required=True); ap.add_argument("--b", required=True)
+ap.add_argument("--a-scale", type=float, default=1.0)
+ap.add_argument("--out", default=None)
+g = ap.parse_args()
+
+def load(d):
+    cams = json.load(open(f"{d}/cameras.json"))["cameras"]
+    return cams, sorted(cams)
+
+ca, na = load(g.a); cb, nb = load(g.b)
+names = [n for n in na if n in cb]
+ratios = []
+for n in names:
+    s = os.path.splitext(n)[0]
+    da = np.load(f"{g.a}/depth/{s}_depth.npy") * g.a_scale
+    db = np.load(f"{g.b}/depth/{s}_depth.npy")
+    cf = np.load(f"{g.b}/depth/{s}_conf.npy")               # b 的天空置信度 = 0
+    da = cv2.resize(da, (db.shape[1], db.shape[0]), interpolation=cv2.INTER_LINEAR)
+    m = (cf > 0) & (da > 0) & (db > 0) & np.isfinite(da) & np.isfinite(db)
+    ratios.append(float(np.median(db[m] / da[m])))
+r = np.array(ratios)
+
+def centers(c): return np.array([c[n]["camera_center_world"] for n in names])
+def rots(c): return np.array([np.array(c[n]["extrinsic_w2c_4x4"])[:3, :3] for n in names])
+A, B = centers(ca) * g.a_scale, centers(cb)
+# Umeyama: 找 s,R,t 使 s*R*A+t ≈ B
+mA, mB = A.mean(0), B.mean(0)
+U, S, Vt = np.linalg.svd((B - mB).T @ (A - mA))
+D = np.eye(3); D[2, 2] = np.sign(np.linalg.det(U @ Vt))
+R = U @ D @ Vt
+s = (S * np.diag(D)).sum() / ((A - mA) ** 2).sum()
+resid = np.linalg.norm((s * (R @ (A - mA).T).T + mB) - B, axis=1)
+# 朝向差: 把 a 的相机朝向转到 b 的世界系再比。w2c_b ≈ w2c_a * R^T
+Ra, Rb = rots(ca), rots(cb)
+ang = []
+for i in range(len(names)):
+    dR = Rb[i] @ (Ra[i] @ R.T).T
+    ang.append(float(np.degrees(np.arccos(np.clip((np.trace(dR) - 1) / 2, -1, 1)))))
+ang = np.array(ang)
+
+def bad(d):
+    p = f"{d}/bad_frames.json"
+    return len(json.load(open(p))["坏帧"]) if os.path.exists(p) else len(pose_check.check_dir(d)["坏帧"])
+
+span = np.linalg.norm(B.max(0) - B.min(0))
+res = dict(frames=len(names), a_scale=g.a_scale,
+           depth_ratio_b_over_a=round(float(np.median(r)), 4),
+           depth_ratio_frame_spread_pct=round(float(np.std(r) / np.mean(r) * 100), 1),
+           traj_sim3_scale=round(float(s), 4),
+           traj_resid_median_m=round(float(np.median(resid)), 3), traj_resid_max_m=round(float(resid.max()), 3),
+           traj_span_b_m=round(float(span), 2),
+           rot_diff_median_deg=round(float(np.median(ang)), 2), rot_diff_max_deg=round(float(ang.max()), 2),
+           rot_diff_over5deg=int((ang > 5).sum()),
+           bad_frames_a=bad(g.a), bad_frames_b=bad(g.b))
+print(json.dumps(res, ensure_ascii=False))
+if g.out:
+    json.dump(res, open(g.out, "w"), indent=1)

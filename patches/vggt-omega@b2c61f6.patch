+def sky_masks(paths, hw):
+    """逐帧天空掩码, 缩到深度图大小, True = 天空。
+    照抄 vggt-omega/visual_util.py 的 segment_sky/run_skyseg: 320x320 输入, 输出归一化后
+    <32 的是"非天空"(官方 demo 就是这个阈值, 没改)。"""
+    import onnxruntime
+    sess = onnxruntime.InferenceSession(f"{WEIGHTS}/skyseg.onnx", providers=["CPUExecutionProvider"])
+    iname, oname = sess.get_inputs()[0].name, sess.get_outputs()[0].name
+    out = []
+    for p in paths:
+        im = cv2.cvtColor(cv2.resize(cv2.imread(p), (320, 320)), cv2.COLOR_BGR2RGB).astype(np.float32)
+        im = ((im / 255 - [0.485, 0.456, 0.406]) / [0.229, 0.224, 0.225]).transpose(2, 0, 1)[None].astype(np.float32)
+        r = np.array(sess.run([oname], {iname: im})).squeeze()
+        r = (r - r.min()) / (r.max() - r.min()) if r.max() > r.min() else np.zeros_like(r)
+        r = cv2.resize((r * 255).astype(np.uint8), (hw[1], hw[0]))
+        out.append(r >= 32)
+    return np.stack(out)
+
+
+def to_da3_conf(conf, sky):
+    """VGGT-Ω 置信度 -> DA3 刻度, 按全场景排名对应(不是逐帧: 整帧都差的帧应该整帧偏低)。
+    天空 = 0, 低于任何门槛。"""
+    ref = np.array(json.load(open(f"{HERE}/da3_conf_ref.json"))["百分位"])
+    ok = ~sky & np.isfinite(conf)
+    qv = np.percentile(conf[ok], np.arange(101))
+    qv = np.maximum.accumulate(qv) + np.arange(101) * 1e-9     # np.interp 要求严格递增
+    out = np.interp(conf, qv, ref).astype(np.float32)
+    out[~ok] = 0.0
+    return out
+

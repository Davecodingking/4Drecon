+def save_infer(path, names, w2c, K, depth, conf_raw, rgb, t_load, t_inf, peak):
+    """--infer-only: 推理结果原样存盘(不压缩; 120 帧约 350 MB, 混合完就删)。先写临时文件再改名, 混合那步读不到写了一半的。"""
+    tmp = f"{path}.tmp.npz"
+    np.savez(tmp, names=np.array([str(n) for n in names]), w2c=w2c, K=K, depth=depth, conf_raw=conf_raw, rgb=rgb,
+             t_load=t_load, t_inf=t_inf, peak=peak)
+    os.replace(tmp, path)

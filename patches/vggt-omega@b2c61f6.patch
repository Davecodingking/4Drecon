+def write_ply(path, pts, cols):
+    """二进制 ply(xyz float + rgb uchar)。vggt_omega 环境没装 trimesh, 手写一个, 读出来和 trimesh 导出的一样。"""
+    v = np.empty(len(pts), dtype=[("x", "<f4"), ("y", "<f4"), ("z", "<f4"), ("red", "u1"), ("green", "u1"), ("blue", "u1")])
+    v["x"], v["y"], v["z"] = pts[:, 0], pts[:, 1], pts[:, 2]
+    v["red"], v["green"], v["blue"] = cols[:, 0], cols[:, 1], cols[:, 2]
+    with open(path, "wb") as f:
+        f.write((f"ply\nformat binary_little_endian 1.0\nelement vertex {len(v)}\n"
+                 "property float x\nproperty float y\nproperty float z\n"
+                 "property uchar red\nproperty uchar green\nproperty uchar blue\nend_header\n").encode())
+        f.write(v.tobytes())

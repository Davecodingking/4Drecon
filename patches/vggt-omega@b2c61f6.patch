@@ -0,0 +1,50 @@
+#!/usr/bin/env python
+"""从现有各场景的 DA3 输出汇总"DA3 置信度长什么样", 写 da3_conf_ref.json。
+vggt_omega_geom.py 用它把 VGGT-Ω 的置信度换算成 DA3 的刻度。
+
+★ 为什么要换算: 流水线里的置信度门槛全是按 DA3 的数值调的(室外 CONF_MIN=2.0、beach 1.0、
+  室内 OBJ_CONF=1.2 / CONF_MIN=1.5), 下游 boxes_from_masks.py 等脚本直接拿 *_conf.npy 比这个数。
+  VGGT-Ω 的置信度量纲完全不同(ithor312 上中位 10.3, DA3 是 2.9), 原样喂进去门槛就失效。
+★ 怎么换: 按排名对应。VGGT-Ω 某像素的置信度在本场景排第 p 百分位, 就给它 DA3 参考分布里
+  第 p 百分位的值。这样"丢掉最差的百分之几"的效果和 DA3 下大致一样。
+  参考分布 = 下面这些场景各抽相同数量的像素混在一起(每个场景权重相同, 不让帧多的场景占大头)。
+★ 这是近似: DA3 自己在不同场景上分布差很多(beach 30% 分位 1.68, pedestrian r2 是 8.84),
+  所以同一个门槛在 DA3 下每个场景丢的比例本来就不同, 换算后变成"每个场景丢的比例一样"。
+  门槛要是对 VGGT-Ω 不合适, 直接在流水线配置里改门槛, 不用改这张表。
+
+  python build_conf_ref.py      # sam3d 环境, 纯 CPU, 几秒
+"""
+import glob, json, os
+import numpy as np
+
+D = os.path.expanduser("~/sam3d/data")
+# 每个场景只取一份(r2sim / r3 这类是同一份 DA3 结果的拷贝, 不重复算)
+SRC = [
+    f"{D}/outdoor/result/beach/r1/02_da3",
+    f"{D}/outdoor/result/carpark/r1/02_da3",
+    f"{D}/outdoor/result/pedestrian/r2/02_da3",
+    f"{D}/outdoor/result/timesquare/r1/02_da3",
+    f"{D}/indoorOutput/ithor312/r1/02_da3",
+    f"{D}/indoorOutput/cyberpunk/o1/02_da3",
+]
+PER_SCENE = 400_000
+rng = np.random.default_rng(0)
+pools, used = [], []
+for s in SRC:
+    fs = sorted(glob.glob(f"{s}/depth/*_conf.npy"))
+    if not fs:
+        print("[跳过] 没有置信度文件:", s); continue
+    c = np.concatenate([np.load(f).ravel() for f in fs])
+    c = c[np.isfinite(c)]
+    c = c[c > 1.0 + 1e-4]   # DA3 置信度下限就是 1.0, 正好 1.0 的一大坨基本是天空(beach 占 ~30%)。
+                            # VGGT-Ω 那边天空单独置 0, 参考表里留着这坨会让门槛多丢 ~15% 的正常像素
+    pools.append(rng.choice(c, PER_SCENE, replace=len(c) < PER_SCENE)); used.append(s)
+    print(f"{s}: {len(fs)} 帧, 中位 {np.median(c):.2f}")
+q = np.percentile(np.concatenate(pools), np.arange(101)).astype(float)
+out = os.path.join(os.path.dirname(os.path.abspath(__file__)), "da3_conf_ref.json")
+json.dump(dict(说明="DA3 置信度的混合分布, 第 i 项 = 第 i 百分位。用法见 build_conf_ref.py 文件头",
+               来源=used, 每场景像素数=PER_SCENE, 百分位=[round(v, 4) for v in q]),
+          open(out, "w"), ensure_ascii=False, indent=1)
+for t in (1.0, 1.2, 1.5, 2.0):
+    print(f"门槛 {t}: 参考分布里约丢 {np.searchsorted(q, t)}%")
+print("->", out)

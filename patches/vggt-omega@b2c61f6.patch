+        pts, cols = pts[sel], cols[sel]
+    write_ply(f"{d}/points.ply", pts, cols)
+    lo, hi = np.percentile(pts, 1, 0), np.percentile(pts, 99, 0)
+    cen = np.array([cams[n]["camera_center_world"] for n in names])
+    s = (f"\n== --pose-into: geometry replaced by VGGT-Omega (DA3 kept as conf mask + metric ruler) ==\n"
+         f"processed HxW: {H}x{W}\n"
+         f"scale to DA3: x{scale:.4f} (from {len(ratios)} frames, per-frame spread {spread:.1f}%); "
+         f"depth disagree >2x -> conf 0: {disagree.mean()*100:.2f}% px\n"
+         f"points: {len(pts)} (conf min {a.conf_min})\n"

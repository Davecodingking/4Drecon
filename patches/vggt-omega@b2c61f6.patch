+#!/usr/bin/env python
+"""VGGT-Ω 推理, 结果按 DA3 的目录格式落盘(cameras.json + depth/*_depth.npy, *_conf.npy),
+让现成的对比脚本和坏帧筛选(pose_check.py)不改就能用。
+  python vggt_omega_to_da3fmt.py --images 帧目录 --out 输出目录 --ckpt 权重 --res 512 [--names 0000.jpg ...]
+"""
+import argparse, glob, json, os, time
+import numpy as np, torch
+from vggt_omega.models import VGGTOmega
+from vggt_omega.utils.load_fn import load_and_preprocess_images
+from vggt_omega.utils.pose_enc import encoding_to_camera
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--images", required=True); ap.add_argument("--out", required=True)
+ap.add_argument("--ckpt", required=True); ap.add_argument("--res", type=int, default=512)
+ap.add_argument("--names", nargs="*", default=None)
+a = ap.parse_args()
+names = a.names or sorted(os.path.basename(p) for p in glob.glob(f"{a.images}/*.jpg"))
+paths = [f"{a.images}/{n}" for n in names]
+os.makedirs(f"{a.out}/depth", exist_ok=True)
+
+t0 = time.time()
+model = VGGTOmega().to("cuda").eval()
+model.load_state_dict(torch.load(a.ckpt, map_location="cpu"))
+t_load = time.time() - t0
+imgs = load_and_preprocess_images(paths, image_resolution=a.res).to("cuda")
+torch.cuda.reset_peak_memory_stats(); torch.cuda.synchronize(); t1 = time.time()
+with torch.inference_mode():
+    pred = model(imgs)
+torch.cuda.synchronize(); t_inf = time.time() - t1
+ext, K = encoding_to_camera(pred["pose_enc"], pred["images"].shape[-2:])
+ext, K = ext[0].float().cpu().numpy(), K[0].float().cpu().numpy()
+dep = pred["depth"][0].float().cpu().numpy().squeeze(-1)
+conf = pred["depth_conf"][0].float().cpu().numpy()
+H, W = dep.shape[1:]
+cams = {}
+for i, n in enumerate(names):
+    w2c = np.eye(4); w2c[:3] = ext[i]
+    np.save(f"{a.out}/depth/{n[:-4]}_depth.npy", dep[i].astype(np.float32))
+    np.save(f"{a.out}/depth/{n[:-4]}_conf.npy", conf[i].astype(np.float32))
+    cams[n] = dict(extrinsic_w2c_4x4=w2c.tolist(), intrinsic_3x3=K[i].tolist(),
+                   camera_center_world=np.linalg.inv(w2c)[:3, 3].tolist(), input_hw=[H, W],
+                   mean_conf=float(conf[i].mean()))
+json.dump(dict(convention="OpenCV w2c; world = camera frame of first image; scale NOT guaranteed metric",
+               model=os.path.basename(a.ckpt), process_res=a.res, source=a.images, cameras=cams),
+          open(f"{a.out}/cameras.json", "w"), indent=1)
+open(f"{a.out}/summary.txt", "w").write(
+    f"frames: {len(names)}\nprocessed HxW: {H}x{W}\n"
+    f"time: model load {t_load:.1f}s, inference {t_inf:.2f}s, peak VRAM {torch.cuda.max_memory_allocated()/1e9:.2f} GB\n"
+    f"depth range {dep.min():.3f}..{dep.max():.3f}, median {np.median(dep):.3f}\n")
+print(open(f"{a.out}/summary.txt").read())

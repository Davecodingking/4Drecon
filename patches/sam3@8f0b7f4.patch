+#!/bin/bash
+# 第 1 步：用 SAM 3 标记你要的物体 → 生成 frame.png + mask.png
+# 用法：改下面变量，然后  bash seg.sh
+# 结果在 ~/sam3d/sam-3d-objects/my_images/<NAME>/ ，之后去 sam-3d-objects 里跑 run.sh 时
+#   IMAGE=my_images/<NAME>/frame.png   MASK=my_images/<NAME>/mask.png
+
+# ===== 改这里 =====
+INPUT=test_video.mp4        # 图片 (xxx.jpg/png) 或 视频 (xxx.mp4)，脚本自动判断
+TEXT="bottle"               # 要的物体，英文，如 "chair" "sofa" "red car"
+NAME=video_test             # 输出名字
+INDEX=0                     # 命中多个同类物体时取第几个（0 = 置信度/面积最大的）
+# ==================
+
+cd "$(dirname "$0")"
+source ~/sam3d/env_sam3.sh
+
+case "${INPUT,,}" in
+  *.mp4|*.mov|*.avi|*.mkv) MODE=--video ;;
+  *)                       MODE=--image ;;
+esac
+
+python segment.py $MODE "$INPUT" --text "$TEXT" --out "$NAME" --index "$INDEX" 2>&1 | grep -vE "Warning|warn|pkg_resources"

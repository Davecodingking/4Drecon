+#!/usr/bin/env python
+"""按框选候选: SAM3 文字提示出全部候选 mask, 取与给定框 IoU 最高者 (置信度只当次要排序)."""
+import argparse, os, sys
+import numpy as np, torch, cv2
+from PIL import Image, ImageOps
+ap = argparse.ArgumentParser()
+ap.add_argument("--image", required=True); ap.add_argument("--text", required=True)
+ap.add_argument("--box", required=True); ap.add_argument("--out", required=True)
+a = ap.parse_args()
+CKPT = os.path.expanduser("~/sam3d/sam3/checkpoints/sam3.pt")
+from sam3.model_builder import build_sam3_image_model
+from sam3.model.sam3_image_processor import Sam3Processor
+pil = ImageOps.exif_transpose(Image.open(a.image)).convert("RGB"); W, H = pil.size
+model = build_sam3_image_model(checkpoint_path=CKPT, load_from_HF=False)
+proc = Sam3Processor(model)
+with torch.autocast("cuda", dtype=torch.bfloat16):
+    state = proc.set_image(pil)
+    state = proc.set_text_prompt(a.text, state)
+masks, scores = state["masks"], state["scores"]
+if len(masks) == 0: sys.exit("无候选")
+x1, y1, x2, y2 = map(float, a.box.split(","))
+bm = np.zeros((H, W), bool); bm[int(y1):int(y2), int(x1):int(x2)] = True
+mn = masks.squeeze(1).cpu().numpy().astype(bool)
+best, bi = -1, 0
+for i in range(len(mn)):
+    inter = (mn[i] & bm).sum(); union = (mn[i] | bm).sum()
+    iou = inter/max(union,1); inside = inter/max(mn[i].sum(),1)
+    v = iou * inside            # 既要重合又要别跑到框外
+    if v > best: best, bi = v, i
+print(f"候选 {len(mn)} 个, 选第 {bi} (IoU分 {best:.3f}, SAM置信度 {float(scores[bi]):.2f})")
+outd = os.path.expanduser(f"~/sam3d/sam-3d-objects/my_images/{a.out}"); os.makedirs(outd, exist_ok=True)
+img = np.array(pil)
+Image.fromarray(img).save(os.path.join(outd, "frame.png"))
+Image.fromarray((mn[bi]*255).astype(np.uint8)).save(os.path.join(outd, "mask.png"))
+ov = img.copy(); ov[mn[bi]] = (0.5*ov[mn[bi]] + 0.5*np.array([255,60,60])).astype(np.uint8)
+cv2.rectangle(ov, (int(x1),int(y1)), (int(x2),int(y2)), (60,255,60), 3)
+Image.fromarray(ov).save(os.path.join(outd, "preview.jpg"))
